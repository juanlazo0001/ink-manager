# Copy this file to `.env` and fill in real values for local development.
# See DEVELOPMENT.md for the full dev-vs-production environment convention.

# Development database only. NEVER point this at production -- the prod
# connection string lives in .env.production (gitignored, not this file),
# and is used only for deliberate release steps (`prisma migrate deploy`,
# read-only sanity checks), never for day-to-day dev/test work.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ink_manager_dev"

# Generate real secrets for anything beyond local dev:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-generated-secret"

# Guards POST /studios/bootstrap. Never expose this route publicly.
BOOTSTRAP_SECRET="replace-with-a-generated-secret"

# Base URL of the deployed web app, used to build every public-facing link
# this server generates (intake form, prefill-draft, estimate, deposit,
# waiver, gift card, consent form). In dev this defaults to
# http://localhost:5173 if unset -- fine locally, but in production
# (NODE_ENV=production) an unset value is NOT silently used as a fallback;
# it logs a loud startup error instead, since a missing value there means
# every public link sent to a real client would otherwise point at
# localhost. Set this to the real deployed frontend domain in production
# (e.g. Railway's API service variables), with no trailing slash.
PUBLIC_APP_URL="http://localhost:5173"

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Anthropic API key for Claude-assisted inquiry drafting (POST
# /conversations/:id/draft-inquiry). Called from this server only -- never
# expose this key to the frontend. Get one at console.anthropic.com.
ANTHROPIC_API_KEY="sk-ant-replace-with-a-real-key"

# This API's OWN public base URL (a different domain from PUBLIC_APP_URL
# above -- that's the web frontend's URL, this is the API service's own).
# Used to build the Twilio inbound webhook URL shown in Settings ->
# Integrations and to validate X-Twilio-Signature. Defaults to
# http://localhost:4000 in dev; set to this API's real deployed domain in
# production (Railway's API service variables).
API_PUBLIC_URL="http://localhost:4000"

# Phase 7B: ONE platform-level secret that encrypts every studio's own
# connected-integration credentials (Twilio auth token today; more
# providers land on this same chassis later). Generate with:
#   openssl rand -base64 32
# This is NOT a per-studio secret -- a single studio's Twilio Account
# SID/Auth Token/phone number are never put in this file or in Railway's
# variables; those are connected self-serve, in-app, from Settings ->
# Integrations, by that studio's own OWNER. Losing/rotating this key means
# every studio that's connected an integration has to reconnect it.
INTEGRATION_ENCRYPTION_KEY="replace-with-a-generated-32-byte-base64-key"

# Email integration (Gmail OAuth) -- a PLATFORM-level secret like
# INTEGRATION_ENCRYPTION_KEY above, one value for the whole app, NOT
# per-studio. Create an OAuth 2.0 Client ID (type: Web application) in a
# Google Cloud project with the Gmail API enabled, then register this
# exact redirect URI in that client's "Authorized redirect URIs":
#   {API_PUBLIC_URL}/integrations/email/callback
# (http://localhost:4000/integrations/email/callback in local dev, using
# the API_PUBLIC_URL default above). A studio's own Gmail account is
# connected self-serve, in-app, from Settings -> Integrations, by that
# studio's OWNER -- never put a studio's tokens in this file.
GMAIL_CLIENT_ID="replace-with-your-google-oauth-client-id"
GMAIL_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"

# Phase 7C: Stripe Connect (Standard) -- PLATFORM-level secrets, one value
# for the whole app, NEVER per-studio. Every studio's own connected account
# is created and onboarded self-serve, in-app, from Settings -> Integrations,
# by that studio's OWNER (Connect Onboarding via Account Links -- Stripe
# hosts the entire onboarding UI). Get the two keys below from the Stripe
# Dashboard (Developers -> API keys) with Connect enabled on the platform
# account; start in test mode (sk_test_.../pk_test_...).
STRIPE_SECRET_KEY="sk_test_replace-with-your-platform-secret-key"
# Also needed by the web app's own .env as VITE_STRIPE_PUBLISHABLE_KEY if a
# client-side Stripe.js call is ever added -- not required for the
# redirect-to-Checkout flow this phase uses, kept here for completeness/
# platform-level documentation.
STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-your-platform-publishable-key"
# For local testing, run `stripe listen --forward-to localhost:4000/webhooks/stripe`
# (Stripe CLI) and paste the signing secret it prints -- same local-testing
# pattern as Twilio's own webhook setup. A real dashboard-registered
# endpoint (with its own signing secret) replaces this once deployed.
STRIPE_WEBHOOK_SECRET="whsec_replace-with-your-webhook-signing-secret"
# One platform-wide percentage (e.g. "2.5") applied to every direct charge
# via application_fee_amount -- NOT per-studio yet. Unset or "0" disables
# platform fees entirely (every studio keeps 100% minus Stripe's own fees).
PLATFORM_FEE_PERCENT="0"

# Platform-level Bird API key -- Ink Manager's own transactional
# notification emails (team invites, password resets, email-change
# confirmations), sent via Bird's Email API. NOT a per-studio
# client-conversation credential (that's separate, still-unbuilt work).
# See lib/platformEmail.ts. Region defaults to "us1"; only set BIRD_REGION
# if your key's own prefix (bk_<region>_...) says otherwise.
BIRD_API_KEY="replace-with-your-bird-platform-api-key"
# BIRD_REGION="us1"
