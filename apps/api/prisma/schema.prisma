// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  FRONT_DESK
  ARTIST
  CUSTOMER
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A consultation is the same Appointment record as a real tattoo session,
// distinguished only by this field -- it reuses the calendar, artist
// availability, buffer-conflict logic, and drag-reschedule with zero
// duplication. Only two things actually differ, both handled at the route
// layer, not the schema: a consultation skips the gift-card requirement
// entirely (see POST /appointments), and its completion flow is a simple
// "mark complete" (POST /appointments/:id/complete-consultation) instead
// of full financial checkout (POST /appointments/:id/checkout) -- both
// still just set the same checkedOutAt/closeoutNotes/status fields below.
enum AppointmentType {
  TATTOO_SESSION
  CONSULTATION
}

enum Channel {
  EMAIL
  INSTAGRAM
  FACEBOOK
  // Front desk logging a walk-in or phone-call inquiry on the customer's
  // behalf (see StaffInquiryForm) -- never selectable on the public intake
  // form, which is always self-reported by the customer.
  PHONE
  // Package O: "A friend referred me" -- selecting this on either intake
  // form reveals a text input for the friend's Client.referralCode, looked
  // up and stored as Client.referredByClientId on the new client.
  REFERRAL
  // Flash gallery: never selectable on either intake form -- set only by
  // POST /flash-pieces/:id/request, the lightweight public submission flow
  // (see Inquiry.flashPieceId's own comment). Complements that FK as a
  // second, cheap "how did this inquiry originate" signal that plugs into
  // any existing channel-based reporting with no special-casing needed.
  FLASH_GALLERY
}

enum GiftCardStatus {
  // Stripe checkout-link issuance only: the card row (and its real, final
  // code) exists from the moment staff generates the checkout link, so the
  // webhook has something to find by stripeCheckoutSessionId once payment
  // completes -- but it isn't spendable/attachable yet (validateGift
  // CardForAttachment only ever accepts ACTIVE/EXEMPT). Every other
  // issuance path (Cash, Exempt, a paid deposit) goes straight to ACTIVE/
  // EXEMPT, skipping this status entirely -- it's never set anywhere else.
  PENDING
  ACTIVE
  REDEEMED
  EXPIRED
  VOID
  EXEMPT
}

// Cash payment path: how a GiftCard's value was actually recorded as paid
// -- distinct from GiftCardStatus above (EXEMPT is both a status AND a
// payment method here, since an exempt card never has real money behind
// it either way). Nullable permanently, not nullable-then-tightened: a
// handful of pre-existing paths (the bulk client-import gift-card backfill,
// and checkout's multi-card overage derivation when more than one origin
// card combines) genuinely have no single known payment method to record,
// and fabricating one for historical data would be actively wrong, not
// just incomplete. The real invariant this session's task cares about --
// "no NEW gift card issues without one of these three recorded" -- is
// enforced at the application layer (routes/giftCards.ts, lib/deposits.ts),
// not via a NOT NULL constraint that would force every historical/derived
// row to have a value it can't honestly have.
enum GiftCardPaymentMethod {
  STRIPE
  CASH
  EXEMPT
}

enum LiabilityWaiverStatus {
  PENDING
  SIGNED
  VERIFIED
}

// Package R: mass client import. MAPPING added by the flexible-column-
// mapping revision -- a batch now sits in this stage (raw rows stored,
// nothing parsed/matched yet) between upload and a confirmed column
// mapping, before it ever reaches PENDING_REVIEW.
enum ImportBatchStatus {
  MAPPING
  PENDING_REVIEW
  COMPLETED
  CANCELLED
}

enum ImportRowDecision {
  ADD
  MERGE
  SKIP
}

// Only meaningful for a row whose parsed deposit amount was flagged as an
// outlier (see ImportRow.depositFlaggedAsOutlier) -- required before
// execute for those rows, untouched for every other row. EDIT means the
// staff-supplied corrected amount was written directly into
// ImportRow.parsedDepositCents (no separate "corrected" column -- see the
// PATCH .../rows/:rowId route), so execute always reads parsedDepositCents
// as the final figure regardless of which of these three was chosen.
enum ImportRowDepositDecision {
  IMPORT
  SKIP
  EDIT
}

// Package Q (revised): true intake form builder -- replaces the bounded
// custom-questions-only approach the original Package Q shipped
// (StudioSettings.intakeCustomQuestions), which this session migrates
// forward into IntakeFormField rows rather than discarding.
enum IntakeFieldKind {
  SYSTEM
  CUSTOM
}

enum IntakeCustomQuestionType {
  TEXT
  PARAGRAPH
  NUMBER
  DATE
  YES_NO
  SELECT
  MULTI_SELECT
  PHOTO_UPLOAD
}

enum ConversationType {
  CLIENT
  STAFF
  GROUP
}

enum MessageChannel {
  IN_APP
  SMS
  EMAIL
  INSTAGRAM
  FACEBOOK
  PHONE
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Phase 7B: every channel a studio could eventually self-serve connect.
// Only SMS (Twilio) is actually wired up to a real provider this phase --
// the others exist so Settings -> Integrations can show them as "Coming
// soon" cards on the same chassis rather than a Twilio-shaped one-off.
enum IntegrationChannel {
  SMS
  EMAIL
  INSTAGRAM
  FACEBOOK
  GOOGLE_CALENDAR
  // Phase 7C: reuses this same StudioIntegration chassis, but unlike every
  // channel above there is no per-studio secret to encrypt -- the
  // platform's own Stripe secret key (STRIPE_SECRET_KEY) makes every API
  // call, scoped to the connected account via the stripeAccount request
  // option (the Stripe-Account header). encryptedSecret stays permanently
  // null for this channel; metadata holds
  // { stripeAccountId, chargesEnabled, payoutsEnabled } instead.
  STRIPE
  // Platform-level SMS via Bird, migrating off Twilio (the SMS channel
  // above) studio by studio -- same "no per-studio secret" shape as
  // STRIPE: the platform's own BIRD_SMS_API_KEY (lib/platformSms.ts)
  // sends for every studio, encryptedSecret stays permanently null.
  // "Connect" for this channel is just an opt-in flag, not a real
  // credential exchange -- there's nothing studio-specific to validate.
  // Coexists with SMS (Twilio) rather than replacing it: client-facing
  // sends (composer, reminders, keyword handling) stay on Twilio until a
  // separate future session migrates them once this foundation is proven.
  BIRD_SMS
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum InquiryStatus {
  // Service lines: only an inquiry for a service with
  // requiresCandidacyReview: true lands here on submission, instead of NEW
  // -- before the normal pricing/estimate stage. A service with that flag
  // false (Tattoo, and every other service predating this feature) never
  // sets this status. "Mark Good Candidate" moves it to NEW (resuming the
  // normal pipeline); "Mark Not a Candidate" reuses POST /:id/mark-lost
  // exactly (CLOSED_LOST, same as any other lost inquiry); scheduling a
  // consultation from here reuses the existing consultation appointment
  // feature without changing this status at all.
  CANDIDACY_REVIEW
  NEW
  ARTIST_ASSIGNED
  AWAITING_CLIENT_RESPONSE
  BUDGET_NEGOTIATION
  SCHEDULING
  WAITLISTED
  DEPOSIT_PENDING
  CONFIRMED
  CLOSED_LOST
  COLD_LEAD
  // Transfer-to-artist epic: this project's client and work state moved to
  // the artist's new home studio as a fresh Inquiry there. Same shape as
  // CLOSED_LOST -- a terminal, out-of-pipeline status paired with
  // out-of-band transferredAt/transferredToStudioId/transferredToInquiryId
  // fields below, set once by execution and never reopened (unlike
  // CLOSED_LOST's own reopen route -- a transfer is not reversible).
  TRANSFERRED
  // Flash gallery: the two statuses a flash-sourced inquiry moves through
  // BEFORE it rejoins the normal pipeline at SCHEDULING (reused as-is once
  // paid -- Part 3, not yet built). Skips ARTIST_ASSIGNED/
  // AWAITING_CLIENT_RESPONSE/BUDGET_NEGOTIATION/DEPOSIT_PENDING entirely --
  // the artist, price, and duration are already fixed by the FlashPiece
  // itself, so there's no assignment or estimate step to move through.
  //
  // Submitted, awaiting front desk's review of the placement photo/
  // description and customer info (POST /flash-pieces/:id/request).
  FLASH_PENDING_APPROVAL
  // Approved by front desk, awaiting the customer's full prepayment
  // (Part 3's own Stripe Checkout flow, a distinct mechanism from the
  // deposit-tier gift-card system -- see that part's own comment).
  FLASH_PAYMENT_PENDING
  // Prepay + On-Hold epic, Part 1: a staff-initiated pause on an
  // already-converted Project, paired with statusBeforeHold/holdReason/
  // heldAt below (same out-of-band-fields-alongside-a-status shape as
  // lostAt/lostReason next to CLOSED_LOST) -- NOT terminal like
  // CLOSED_LOST/TRANSFERRED, since release restores statusBeforeHold and
  // resumes the pipeline exactly where it left off.
  ON_HOLD
}

model Studio {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  // Artist public page v2: a distinct asset from logoUrl above -- logoUrl
  // is the studio's full wordmark/lockup (used in PDFs, OG tags, the
  // studio-facing branding contexts logoUrl already served before this
  // field existed), sized and composed for those uses. iconLogo is a
  // separate upload specifically for the small circular studio-card mark
  // on the artist's own public page -- a studio's full logo often doesn't
  // read cleanly cropped into a ~70px circle the way a dedicated outline
  // icon does. Same base64 data: URL storage convention as logoUrl (see
  // lib/images.ts), independently nullable -- most studios won't have one
  // yet, in which case the studio card falls back to a Fraunces initial
  // in a thin ring rather than blocking on it.
  iconLogo  String?
  website   String?
  createdAt DateTime @default(now())

  // Studio setup wizard eligibility gate -- same shape and contract as
  // Artist.profileSetupCompletedAt (see that field's own schema comment):
  // null means "hasn't finished or explicitly skipped the first-login
  // wizard," set once on finish OR explicit skip, never on plain
  // navigation-away. The migration adding this backfills every EXISTING
  // studio (Black Hive included) to the migration's own timestamp, so only
  // a Studio created after this deploy -- via public self-serve signup or
  // the platform-operator create-studio.ts script, both equally unconfigured
  // -- is ever eligible.
  setupCompletedAt DateTime?

  users                   User[]
  clients                 Client[]
  appointments            Appointment[]
  locations               Location[]
  rolePermissions         RolePermission[]
  inquiries               Inquiry[]
  inquiryNotes            InquiryNote[]
  appointmentNotes        AppointmentNote[]
  auditLogs               AuditLog[]
  giftCards               GiftCard[]
  settings                StudioSettings?
  liabilityWaivers        LiabilityWaiver[]
  taskDismissals          TaskDismissal[]
  personalTasks           PersonalTask[]
  sectionSeens            SectionSeen[]
  conversations           Conversation[]
  messages                Message[]
  conversationTags        ConversationTag[]
  prefillDrafts           PrefillDraft[]
  integrations            StudioIntegration[]
  artistReminderLogs      ArtistReminderLog[]
  dismissedDuplicatePairs DismissedDuplicatePair[]
  customPolicies          CustomPolicy[]
  importBatches           ImportBatch[]
  intakeFormFields        IntakeFormField[]
  intakeForms             IntakeForm[]
  services                Service[]
  flashPieces             FlashPiece[]
  artistMemberships       StudioMembership[]
  artistMembershipInvites ArtistMembershipInvite[]
  notifications           Notification[]

  // Transfer-to-artist epic: this studio as either side of a transfer, or
  // as the recorded destination on a moved Client/Inquiry.
  transfersAsOrigin             ArtistTransfer[] @relation("TransferOrigin")
  transfersAsDestination        ArtistTransfer[] @relation("TransferDestination")
  clientsTransferredIn          Client[]         @relation("ClientTransferredToStudio")
  inquiriesTransferredIn        Inquiry[]        @relation("InquiryTransferredToStudio")

  // Multi-language public forms, Part 2: studioId is duplicated onto every
  // translation row (see e.g. FlashPieceTranslation's own comment for why),
  // so each of these back-relations exists purely for that direct FK, not
  // because translations are looked up FROM the studio in practice (every
  // real read goes through the specific parent row's own translations
  // relation instead).
  studioSettingsTranslations  StudioSettingsTranslation[]
  intakeFormFieldTranslations IntakeFormFieldTranslation[]
  customPolicyTranslations    CustomPolicyTranslation[]
  serviceTranslations         ServiceTranslation[]
  flashPieceTranslations      FlashPieceTranslation[]
}

// Self-serve provider connections -- a studio owner connects their OWN
// Twilio (etc.) account from Settings -> Integrations, rather than the
// platform holding one shared set of provider credentials for every
// studio. encryptedSecret is AES-256-GCM ciphertext (see lib/secrets.ts),
// decrypted only server-side at send/receive time -- no route ever
// returns it, only masked display values. metadata is deliberately
// separate from encryptedSecret: non-secret config an inbound webhook
// needs to route by (e.g. the studio's own Twilio phone number), safe to
// read back to the client as-is.
model StudioIntegration {
  id              String             @id @default(cuid())
  channel         IntegrationChannel
  status          IntegrationStatus  @default(NOT_CONNECTED)
  displayName     String?
  encryptedSecret String?
  metadata        Json?
  lastError       String?
  connectedAt     DateTime?
  updatedAt       DateTime           @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  @@unique([studioId, channel])
}

model RolePermission {
  id            String  @id @default(cuid())
  role          Role
  permissionKey String
  allowed       Boolean @default(false)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  @@unique([studioId, role, permissionKey])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  hours     Json?
  createdAt DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  users User[]

  @@index([studioId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Nullable as of the account-lifecycle work: a freshly-invited user has a
  // real row (so the invite can carry a role/studio/token) but no password
  // yet -- they set one for the first time in POST /invite/accept/:token.
  // Relaxing this (String -> String?) is the safe direction: every existing
  // row already has a real hash, so no data migration is needed, and every
  // login/team-management read path below already treats a null password as
  // "can't possibly match" rather than assuming a hash is always present.
  password  String?
  name      String?
  phone     String?
  avatarUrl String?
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // Pending invite: set together at invite time, both cleared together on
  // accept (or on cancel, which deletes the row outright -- see
  // routes/studios.ts). A non-null inviteToken with no expired check yet is
  // what GET /invite/verify/:token and the Team page's "pending invites"
  // section both key off, rather than a separate status enum.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  // Public self-serve signup. emailVerifiedAt is set once, either at
  // invite-accept time for every invite-based path (team invite, artist
  // invite, the platform-operator create-studio.ts script -- clicking the
  // emailed link IS the ownership proof there) or via
  // POST /auth/verify-email/:token for a self-serve signup. The actual
  // login gate is emailVerificationToken alone, not emailVerifiedAt: only a
  // self-serve signup ever has this set at creation (every invite-based
  // path leaves it null, same as it leaves emailVerifiedAt null until
  // accept), and it's cleared back to null the moment verification
  // succeeds -- a non-null token IS "pending verification," regardless of
  // emailVerifiedAt's own value, so the two can never disagree.
  emailVerifiedAt                 DateTime?
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // Forgot-password recovery. Deliberately separate from emailChangeToken/
  // inviteToken below (three independent flows, three independent tokens)
  // rather than one shared "pendingToken" column -- a user could otherwise
  // have two of these flows in flight at once (e.g. an admin resends an
  // invite while the invitee is also mid password-reset) and clobber one
  // with the other.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  // Change-email (while logged in). The account keeps authenticating with
  // `email` (the OLD address) until POST /auth/confirm-email-change/:token
  // succeeds, at which point `email` becomes `pendingEmail` and both
  // pending fields clear -- see that route. Never switches over on request,
  // only on confirmed accept, so a typo'd new address can't lock anyone out.
  pendingEmail              String?
  emailChangeToken          String?   @unique
  emailChangeTokenExpiresAt DateTime?

  // Session invalidation. Sifted directly in the JWT auth middleware: a
  // token whose `iat` predates this (password reset or self-service change)
  // is rejected outright, even if it hasn't expired yet -- see
  // middleware/auth.ts. Null means "never changed since the account was
  // created," which is never itself treated as a reason to reject a token.
  passwordChangedAt DateTime?

  // Deactivation. isActive is still the actual authority (already checked
  // at login and already toggle-able via PATCH /:studioId/users/:userId,
  // both pre-existing) -- these two are audit metadata recording WHEN and
  // BY WHOM, kept in sync with isActive by that same PATCH route rather
  // than introduced as a second, competing status signal. The auth
  // middleware also rejects any token for a user with deactivatedAt set,
  // regardless of the token's own age, so deactivation takes effect on the
  // very next request, not just future logins.
  deactivatedAt    DateTime?
  deactivatedById  String?
  deactivatedBy    User?     @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedUsers User[]    @relation("UserDeactivatedBy")

  // Self-deletion (artist account deletion, Part 3). Distinct from
  // deactivatedAt above: deactivation is reversible and staff-initiated
  // (toggle-able back on); this is permanent and self-initiated only (see
  // POST /users/me/delete-account, requireRole(ARTIST) -- never reachable
  // from any studio-side/staff route, confirmed adversarially). The row
  // itself is never deleted -- every FK a real appointment/inquiry/gift
  // card/etc. already holds against this User/Artist id needs to keep
  // resolving to a real (now-anonymized) row, exactly the same
  // "preserve history, only change access" principle deactivation and
  // studio departure already use elsewhere. isActive is set false at the
  // same time (the actual login-blocking authority, same as deactivation),
  // so this field is audit metadata, not a second competing gate.
  deletedAt DateTime?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  artist Artist?
  client Client?

  auditLogs                 AuditLog[]
  issuedGiftCards           GiftCard[]
  verifiedWaivers           LiabilityWaiver[]         @relation("WaiverVerifiedBy")
  checkedOutAppointments    Appointment[]             @relation("AppointmentCheckedOutBy")
  completedProjects         Inquiry[]                 @relation("ProjectCompletedBy")
  taskDismissals            TaskDismissal[]
  personalTasks             PersonalTask[]
  createdPersonalTasks      PersonalTask[]            @relation("PersonalTaskCreatedBy")
  sectionSeens              SectionSeen[]
  staffConversation         Conversation?             @relation("StaffConversation")
  archivedConversations     Conversation[]            @relation("ConversationArchivedBy")
  authoredMessages          Message[]                 @relation("MessageAuthor")
  messageReactions          MessageReaction[]
  authoredInquiryNotes      InquiryNote[]             @relation("InquiryNoteAuthor")
  authoredAppointmentNotes  AppointmentNote[]         @relation("AppointmentNoteAuthor")
  uploadedAppointmentPhotos AppointmentPhoto[]        @relation("AppointmentPhotoUploadedBy")
  conversationReads         ConversationRead[]
  conversationParticipant   ConversationParticipant[]
  createdConversationTags   ConversationTag[]
  createdPrefillDrafts      PrefillDraft[]
  dismissedDuplicatePairs   DismissedDuplicatePair[]
  uploadedImportBatches     ImportBatch[]
  widgetLayouts             UserWidgetLayout[]
  calendarPreference        UserCalendarPreference?

  // Notification system. One switch, per person, covering PUSH only --
  // the in-app bell feed is never suppressed by it (a notification you
  // can go and look at is not an interruption, and hiding a record you
  // still hold is how people end up not knowing something happened).
  // Defaults true so existing accounts behave as though they had opted
  // in, which is the behaviour they get today from nothing at all.
  pushEnabled   Boolean        @default(true)
  notifications Notification[] @relation("NotificationRecipient")
  // Per-user, per-thread preferences -- pin and mute. Distinct from
  // Conversation.archivedAt, which is deliberately studio-wide.
  conversationStates UserConversationState[]
  // The other side: things this person DID that notified someone else.
  // Kept so "who assigned this to me" survives on the row rather than
  // only in the rendered sentence.
  actedNotifications Notification[] @relation("NotificationActor")
  pushTokens         PushToken[]

  initiatedTransfers        ArtistTransfer[]          @relation("TransferInitiatedBy")
  respondedTransfers        ArtistTransfer[]          @relation("TransferRespondedBy")
  cancelledTransfers        ArtistTransfer[]          @relation("TransferCancelledBy")

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  @@index([studioId])
}

model Artist {
  id              String   @id @default(cuid())
  bio             String?
  specialties     String[]
  portfolioImages String[]

  // Manual, staff-entered links only -- no automatic profile/photo/bio
  // import from Instagram or Facebook this pass. That would need the same
  // Meta Business API + App Review process already planned for the
  // client-facing channel integration (Phase 7B); doing it here ahead of
  // that would mean either a scraper (unreliable, likely ToS-violating) or
  // duplicate integration work later.
  instagramHandle    String?
  facebookProfileUrl String?

  // Explicit opt-in public contact channel -- deliberately separate from
  // the account login email (User.email), which must never be surfaced on
  // the public artist page. Null until the artist (or a staff member with
  // profile-edit delegation) fills this in.
  publicContactEmail String?

  // Advisory weekly availability, not enforced (same philosophy as the
  // scheduling buffer warning -- it informs staff, doesn't block them).
  // Shape: Array<{ dayOfWeek: 0-6 (0 = Sunday), startTime: "HH:MM", endTime: "HH:MM" }>
  preferredSchedule Json?

  // Guest artist window -- both nullable/independent of isGuest so a guest
  // can be flagged before dates are picked. Visibility rules (default-
  // hidden past guestEndDate, reachable via a filter toggle) live on
  // Calendar and assignment pickers, not here; this tab always shows guests
  // regardless of window.
  isGuest        Boolean   @default(false)
  guestStartDate DateTime?
  guestEndDate   DateTime?

  // Reference rate(s) for this artist -- both nullable/independent (an
  // artist can have neither, either, or both set) and purely informational
  // by default: the estimate form's per-session price auto-suggestion
  // (hourlyRateCents x that session's own hour estimate, or flatRateCents
  // verbatim if set) only ever pre-fills a starting number staff can
  // override, never locks or validates against it.
  hourlyRateCents Int?
  flatRateCents   Int?

  // Settings "Defaults" tab audit follow-up: per-artist override of
  // StudioSettings.schedulingBufferMinutes -- null (the default) means
  // "use the studio's own default", same nullable-means-inherit convention
  // hourlyRateCents/flatRateCents above already use. An artist who tattoos
  // in shorter sessions (or wants more breathing room than the studio's
  // usual default) can set their own without changing it for every other
  // artist.
  schedulingBufferMinutes Int?

  // Client self-scheduling exploration: off by default, preserving today's
  // staff-only booking flow for every existing artist. When true, an
  // estimate PROCEED response for this artist issues a self-schedule token
  // instead of the normal DEPOSIT_PENDING-only flow, letting the client
  // pick from this artist's real suggested availability. Their pick still
  // only creates a REQUESTED (pending) Appointment, never CONFIRMED --
  // staff reviews and confirms it, same as any other booking. Per-artist,
  // not a studio-wide switch, since some artists may not want clients
  // seeing their calendar at all.
  allowsClientSelfScheduling Boolean @default(false)

  // Flash requests + review mode expansion: who reviews a flash-gallery
  // booking request for THIS artist's own pieces before the client can pay
  // -- artist-owned, full stop, same "no staff bypass exists" shape as
  // publishedAt below (NOT allowsClientSelfScheduling's studio-manageable
  // pattern above, since this isn't a studio booking-policy switch, it's
  // the artist's own call on their own art -- including the choice to let
  // the studio review it instead). Was a Boolean (reviewsFlashRequestsBeforeBooking);
  // migrated true -> ARTIST, false -> NONE, preserving both existing
  // behaviors exactly. STUDIO is the new third option -- see
  // FlashReviewMode's own comment.
  flashReviewMode FlashReviewMode @default(ARTIST)

  // Onboarding wizard eligibility gate. Null means "hasn't finished or
  // explicitly skipped the first-login wizard yet" -- the web app shows it
  // whenever this is null for the logged-in artist. Set once, on finish OR
  // explicit skip, never on plain navigation-away (so an abandoned wizard
  // re-offers next login). The migration adding this column backfills every
  // EXISTING row to the migration's own timestamp, so only an Artist row
  // created after this deploy is ever eligible -- an existing artist never
  // sees a wizard for a profile they already set up.
  profileSetupCompletedAt DateTime?

  // 6a Epic: public artist page. Unique but nullable -- most artists never
  // publish one. Chosen by the artist (or defaulted, see routes/artists.ts),
  // used as the sole public lookup key (GET /artists/public/:publicSlug),
  // so it's never reused even after an artist unpublishes/republishes with
  // a new one (the old slug just starts 404ing, same "URLs are forever"
  // convention Studio.slug already follows).
  publicSlug  String?   @unique
  // Null = unpublished (default -- every existing artist stays exactly as
  // invisible as before this feature shipped). Set to the publish moment,
  // cleared on unpublish -- same nullable-timestamp-as-flag convention as
  // profileSetupCompletedAt/Studio.setupCompletedAt above, not a separate
  // boolean, so "when did this go live" is never a second field to keep in
  // sync. Publishing additionally requires publicSlug to be set AND the
  // artist's home studio to have at least one Location on file
  // (publishable-requires-location rule, enforced in the route, not here --
  // see routes/artists.ts).
  publishedAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  appointments       Appointment[]
  preferredInquiries Inquiry[]           @relation("PreferredArtist")
  assignedInquiries  Inquiry[]           @relation("AssignedArtist")
  reminderLogs       ArtistReminderLog[]
  // Package R (artist-matching follow-up): rows from a mass import whose
  // artist-name column matched (exactly or fuzzily) THIS artist -- purely
  // informational, same "reverse pointer with no effect on the artist's
  // own fields" convention as Client.matchedImportRows below.
  matchedImportRows  ImportRow[]
  artistServices     ArtistService[]
  flashPieces        FlashPiece[]
  // 6a Epic: denormalized from Residency.membership.artistId -- see that
  // field's own comment for why (the cross-studio overlap invariant is a
  // per-artist question a DB constraint can't express through a join).
  residencies        Residency[]

  // Solo artist architecture, Phase 1: the real Studio<->Artist affiliation
  // model, replacing the implicit single-valued Artist.user.studioId chain
  // as the source of truth for "which studio(s) is this artist part of."
  // Deliberately NOT a replacement for auth/session studioId (User.studioId
  // is untouched this phase) -- this is an additional layer describing
  // affiliation, not a rewrite of login/JWT architecture. See REPORT.md
  // ("Solo artist architecture -- Phase 1") for the full investigation this
  // was built from.
  memberships StudioMembership[]

  transfers ArtistTransfer[]
}

// HOME: the artist's normal, primary studio membership -- every existing
// Artist gets exactly one of these (Part 2's migration). GUEST: Phase 2's
// not-yet-built second-studio linking; the field exists now so that phase
// doesn't require another foundational migration, per this task's own
// explicit instruction.
enum StudioMembershipType {
  HOME
  GUEST
}

model StudioMembership {
  id String @id @default(cuid())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  type StudioMembershipType @default(HOME)

  // Null while the membership is active. Set once, never cleared -- see
  // the comment below this model for the full "why" and the two partial
  // unique indexes that depend on it.
  endedAt DateTime?

  // Artist-controlled delegation: whether THIS studio's staff (including
  // OWNER -- the whole point is protecting the artist's own data FROM
  // studio control, so OWNER is not exempt) may edit this artist's shared
  // portfolio photos / flash gallery pieces / bio on their behalf. Default
  // OFF -- must be explicitly granted by the artist, never assumed. Scoped
  // precisely to those fields (enforced in Part 4); never login credentials,
  // never the artist's own scheduling/self-booking settings
  // (schedulingBufferMinutes, allowsClientSelfScheduling, Artist.userId/
  // login) -- those stay gated by the existing artists.manage permission
  // (or, for a solo artist per Part 3, the artist's own direct control)
  // regardless of this toggle. Lives on the general membership model (not
  // HOME-only) so Phase 2's GUEST rows get the identical mechanism for
  // free -- Part 4's enforcement only ever reads this off a HOME row this
  // phase, so behavior is unchanged from a HOME-only field for now.
  allowsStudioProfileEdits Boolean @default(false)

  createdAt DateTime @default(now())

  // 6a Epic: a membership is the ONGOING relationship (an artist has been
  // invited/accepted as a guest at this studio, full stop); residencies are
  // the individual SCHEDULED STINTS within it -- many per membership, e.g.
  // a touring guest artist who visits the same host every summer gets one
  // membership and a new Residency each year, not a new membership each
  // time. See Residency's own comment for the accept/overlap rules.
  residencies Residency[]

  // Artist mobility: a membership is never deleted when an artist leaves
  // (goes solo, or moves their HOME elsewhere) -- endedAt is set instead,
  // same "preserve history, only change access" principle as User's own
  // isActive/deactivatedAt. Every access-control read filters on
  // endedAt: null; every historical read (past appointments, audit trail
  // at the departed studio) is completely untouched by this, since nothing
  // about those records points at StudioMembership at all.
  //
  // Two partial unique indexes exist at the DB level, both hand-authored
  // in migration SQL -- not representable as `@@unique` in Prisma's schema
  // DSL, which has no WHERE clause:
  //   - (studioId, artistId) WHERE endedAt IS NULL: an artist can't hold
  //     two simultaneous ACTIVE memberships at the same studio, but CAN
  //     rejoin a studio they'd previously left (a new row, old one stays
  //     ended -- preserves the full history of separate stints).
  //   - (artistId) WHERE type = 'HOME' AND endedAt IS NULL: an artist can
  //     never have more than one active HOME at a time -- the actual
  //     invariant every "go solo" / "change home" transition depends on,
  //     now enforced by the database itself rather than left purely
  //     application-level as Phase 1 originally deferred it.
  @@index([artistId])
  @@index([studioId])
}

enum ResidencyStatus {
  // Host-created stint, not yet acted on by the artist -- see
  // routes/residencies.ts for who can create one in this state (host
  // staff, matrix-gated) vs. who lands directly in CONFIRMED (the artist's
  // own first stint, created by their OWN invite-acceptance -- consent is
  // implicit in accepting the invite at all).
  PENDING
  // Artist has accepted -- the one state the overlap invariant and
  // Part 3's availability computation actually key off. Reversible: an
  // already-CONFIRMED stint can still be CANCELLED later (a change of
  // plans), but never silently -- see routes/residencies.ts.
  CONFIRMED
  // Artist explicitly declined a host-created PENDING stint. Terminal --
  // same "audited, reversible only by creating a brand new row" philosophy
  // as Inquiry.closedReason's own mark-lost/reopen pair, except a declined
  // residency has no "reopen," since the artist's decision is theirs alone
  // (see this epic's own "inalienable artist right" framing).
  DECLINED
  // Cancelled after having been PENDING or CONFIRMED -- either side backed
  // out (a host cancelling a booked stint, or an artist backing out of one
  // they'd already accepted). Terminal, same as DECLINED.
  CANCELLED
}

// One SCHEDULED, DATE-BOUNDED stint within a StudioMembership (almost
// always a GUEST one -- nothing stops a HOME membership from having a
// residency too, but nothing in this epic's own design needs that shape,
// so it's simply not prevented rather than specifically supported).
//
// The cross-studio overlap invariant (an artist can have no
// date-overlapping CONFIRMED residencies across ANY studios, home
// included) is enforced at the APPLICATION layer on create and on accept
// (routes/residencies.ts) -- the actual requirement per this epic's own
// task. Also enforced at the DATABASE layer via a hand-authored Postgres
// EXCLUDE constraint in this model's own migration SQL (not representable
// in Prisma's schema DSL, same reason StudioMembership's own two partial
// unique indexes above are hand-authored) -- belt-and-suspenders against a
// bug or a future direct-DB write, never the primary enforcement point.
model Residency {
  id String @id @default(cuid())

  membershipId String
  membership   StudioMembership @relation(fields: [membershipId], references: [id])

  // Denormalized from membership.artistId, set once at creation and never
  // changed (a residency's membership -- and therefore its artist -- is
  // fixed for its lifetime). Needed because the overlap invariant is
  // fundamentally per-ARTIST ("this person can't be in two places at
  // once"), not per-membership, and a Postgres EXCLUDE constraint can't
  // reach through a join to StudioMembership to get there.
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  // Calendar dates (compared as civil dates, UTC-anchored -- same
  // convention Artist.guestStartDate/guestEndDate already established),
  // not specific instants. Both required: unlike the legacy guest window
  // fields they supersede for the multi-stint case, a residency is always
  // a fully-bounded stint from the moment it's proposed, per Part 2's own
  // "dates become MANDATORY" rule for the invite flow.
  startDate DateTime
  endDate   DateTime

  status ResidencyStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membershipId])
  @@index([artistId, status])
}

// Artist mobility, Part 2: a studio-initiated invite specifically for an
// Artist membership (HOME or GUEST), deliberately NOT modeled as a pending
// User row the way team.ts's existing OWNER/FRONT_DESK/(legacy)ARTIST
// invites are. That model can't represent inviting someone whose email
// already belongs to a real account (User.email is unique -- there's no
// "pending" second row to create), so this is decoupled from User
// entirely: every account/membership decision (new identity vs existing,
// HOME vs GUEST resolution) happens once, together, at accept time --
// never split across invite-creation and accept like the old flow, which
// keeps the identity-linking logic in exactly one place. See
// routes/artistInvites.ts.
model ArtistMembershipInvite {
  id String @id @default(cuid())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  email          String
  // Optional -- staff sending the invite may not always have a name to
  // enter, but when they do (Team.tsx's "Invite Artist" form already has
  // this field), it needs somewhere to land until accept time, since a
  // brand-new identity's User row doesn't exist yet to hold it directly.
  // Only ever applied to a genuinely NEW identity at accept
  // (routes/artistInvites.ts) -- an existing identity accepting keeps
  // their own real name untouched.
  name           String?
  membershipType StudioMembershipType

  // 6a Epic: mandatory when membershipType is GUEST (validated in
  // routes/studios.ts's invite-creation route, not here -- Prisma has no
  // conditional-required concept), null/unused for HOME. Carried on the
  // invite itself (not a Residency row -- no StudioMembership exists yet
  // to hang one off) so the dates survive from invite-send to accept, up
  // to the full token TTL later. Consumed exactly once, at accept
  // (routes/artistInvites.ts), to create the artist's own first
  // Residency, landing CONFIRMED directly -- accepting the invite IS the
  // artist's consent, so there is no separate PENDING step for this one.
  residencyStartDate DateTime?
  residencyEndDate   DateTime?

  token          String   @unique
  tokenExpiresAt DateTime

  createdAt DateTime @default(now())

  @@index([studioId])
  @@index([email])
}

// View parity + studio-review mode: who reviews a flash-gallery booking
// request for THIS artist's own pieces before the client can pay.
// ARTIST/NONE are the exact same two behaviors reviewsFlashRequestsBeforeBooking
// (true/false) always had; STUDIO is new -- the request stays at
// FLASH_PENDING_APPROVAL for front desk to approve/decline instead of the
// artist, matrix-gated the same way appointment approvals are (see
// POST /:id/flash/approve and /decline in routes/inquiries.ts).
enum FlashReviewMode {
  ARTIST
  STUDIO
  NONE
}

enum FlashPieceStatus {
  // Visible in the public gallery, requestable. A repeatable
  // (isOneOfOne: false) piece stays here permanently -- being requested,
  // even booked, by one client never removes it from the gallery for the
  // next one. A one-of-one piece is only ever here until its first
  // request comes in.
  AVAILABLE
  // One-of-one only: a request just came in and front desk hasn't
  // reviewed it yet -- hidden from the gallery and not requestable by
  // anyone else in the meantime (Part 2's reservation logic), so the same
  // design can't be double-requested while under review.
  PENDING_APPROVAL
  // One-of-one only: approved, paid, and scheduled -- permanently done,
  // per isOneOfOne's own "retired forever once booked" contract. Distinct
  // from RETIRED below (a booking outcome vs. a manual staff action).
  BOOKED
  // Manually pulled from the gallery by staff/the artist -- e.g. the
  // artist no longer wants to offer this design. Reachable from AVAILABLE
  // regardless of isOneOfOne; never automatically reachable from a
  // booking outcome (that's BOOKED, above).
  RETIRED
}

// Pre-drawn, artist-uploaded art a client can browse and self-book
// directly (skipping the estimate step entirely -- price/duration are
// already fixed by the artist at upload time, not negotiated per client).
model FlashPiece {
  id                       String           @id @default(cuid())
  imageUrl                 String
  title                    String
  description              String?
  priceCents               Int
  // Set by the artist at upload -- feeds directly into the self-scheduling
  // engine's duration target (getSuggestedTimes), same role
  // timeEstimateHoursMin/Max's midpoint plays for a normal estimate.
  estimatedDurationMinutes Int
  // true: once booked, this exact piece is retired forever (status ->
  // BOOKED, never re-offered). false: stays repeatedly bookable by
  // different clients indefinitely -- a booking never changes its status.
  isOneOfOne               Boolean          @default(false)
  status                   FlashPieceStatus @default(AVAILABLE)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  inquiries Inquiry[]

  // Multi-language public forms: studio-authored translations of title/
  // description, one row per locale this piece has been translated into.
  // See FlashPieceTranslation's own comment for why this is a sibling
  // table rather than locale-keyed columns.
  translations FlashPieceTranslation[]

  @@index([studioId, artistId])
  @@index([studioId, status])
}

// Multi-language public forms, Part 2 (schema only): a studio's own
// Spanish (or any future language) version of a FlashPiece's title/
// description. Sibling-table pattern, not locale-keyed columns
// (flashPieceTitleEs, flashPieceTitleFr, ...) -- FlashPiece is a genuine
// one-to-many, unbounded-per-studio table, so a locale-keyed column
// would need a migration touching this table every time a language is
// added. `locale` is a plain, app-validated String (against
// SUPPORTED_LOCALES), not a Prisma enum, for the identical reason --
// same pattern StudioSettings.themePreset already uses against
// THEME_PRESET_KEYS. `studioId` is duplicated here rather than derived
// via flashPieceId -> studioId, matching this schema's own existing
// convention (e.g. FlashPiece.studioId itself exists independently of
// the artist's current studio) for query-scoping and defense-in-depth,
// not because it can ever legitimately disagree with the parent's own
// studioId.
model FlashPieceTranslation {
  id     String @id @default(cuid())
  locale String

  title       String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flashPieceId String
  flashPiece   FlashPiece @relation(fields: [flashPieceId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  @@unique([flashPieceId, locale])
  @@index([studioId, locale])
}

model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Manual, staff-entered links only -- same rationale as Artist's
  // identical fields (see Artist.instagramHandle): no automatic
  // profile/photo import from Instagram or Facebook this pass.
  instagramHandle    String?
  facebookProfileUrl String?
  // Free-text catch-all for any other contact channel not worth a
  // dedicated column (TikTok, personal website, etc.) -- informational
  // display only, no validation beyond basic length.
  otherContact       String?

  // Freeform, single Text field deliberately -- not split into street/
  // city/state/zip sub-fields for v1 (mass-import revision). Editable from
  // the client's own detail page like every other contact field; also
  // settable by a mapped "address" column during mass import.
  address String?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // A client with this set is considered merged/inactive; the surviving
  // client is the one at mergedIntoId. Exclude these from list views.
  mergedIntoId String?
  mergedInto   Client?  @relation("ClientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Client[] @relation("ClientMerge")

  // Package O: every client gets one of these, auto-generated at creation
  // (see lib/referrals.ts) -- short/readable/uppercase, shareable by staff
  // reading it aloud or texting it. Every existing row was backfilled by a
  // one-off script in the same session this column was added, before this
  // NOT NULL constraint landed in a second migration.
  referralCode String @unique

  // Set once, at creation, from the OTHER client's referralCode entered on
  // the intake form -- never overwritten afterward (same never-overwritten
  // pattern as smsConsentGivenAt above). Null means "not referred" or
  // "predates this feature."
  referredByClientId String?
  referredBy         Client?  @relation("ClientReferral", fields: [referredByClientId], references: [id])
  referredClients    Client[] @relation("ClientReferral")

  // Tracks the MOST RECENT referral reward issued to whoever referred this
  // client -- set atomically alongside the gift card, in the same
  // transaction, at a qualifying paid deposit (see lib/deposits.ts).
  // Whether "qualifying" means only this client's very first paid deposit
  // ever, or the first paid deposit of each separate later project too,
  // depends on the studio's own referralAllowRepeatRedemption setting
  // (StudioSettings) -- false (default) makes this a permanent one-time
  // guard, exactly as it always was before that setting existed; true
  // lets a later project's own qualifying deposit overwrite both fields to
  // point at ITS reward instead. Every occurrence (not just the latest) is
  // permanently recoverable via AuditLog's referral_reward_issued action
  // regardless of which mode is active.
  referralRewardIssuedAt   DateTime?
  referralRewardGiftCardId String?   @unique
  referralRewardGiftCard   GiftCard? @relation("ReferralRewardGiftCard", fields: [referralRewardGiftCardId], references: [id])

  // Soft, reversible hide -- same exclude-from-list-views pattern as
  // mergedIntoId above, but fully intact and unarchivable, unlike a merge.
  archivedAt DateTime?

  // Multi-language public forms: null means "no preference set yet" --
  // every public flow (deposit/waiver/estimate/self-schedule/flash-
  // payment) falls back to the client's OWN studio's StudioSettings.
  // defaultLocale until this is set, via the language picker on any of
  // those pages persisting here through that flow's own existing token-
  // scoped endpoint (e.g. PATCH /deposits/:token/locale) -- no new auth
  // mechanism. Once set, every later link for this same client defaults
  // to it, picker still present to override per-visit. Plain,
  // app-validated String (against SUPPORTED_LOCALES), not a Prisma enum,
  // so adding a language is never a migration -- same reasoning as
  // StudioSettings.themePreset's own String-not-enum precedent.
  // Deliberately NOT read by SMS sends (lib/clientSms.ts,
  // lib/jobs/reminderTicker.ts) in v1 -- SMS bodies stay English-only
  // regardless of this value until a dedicated future part; this field
  // existing is just the hook that part would read from later.
  preferredLocale String?

  // Phase 7B: set when this client texts STOP/UNSUBSCRIBE/CANCEL/QUIT to
  // the studio's connected SMS number, cleared on START/UNSTOP. Checked
  // server-side before every outbound SMS send regardless of what the UI
  // shows -- this is the actual enforcement point, not just a display flag.
  smsOptedOutAt DateTime?

  // A2P 10DLC compliance: affirmative, opt-in consent, not just "they gave
  // us a phone number." Set once, the first time it's actually given (the
  // public intake form's required, unchecked-by-default checkbox is the
  // only source today -- smsConsentSource records which flow, so a future
  // second source doesn't have to guess). Never overwritten once set --
  // a returning client's original consent timestamp is preserved across
  // every later submission, staff or public.
  smsConsentGivenAt DateTime?
  smsConsentSource  String?

  // Post-add consent: a client added by staff (walk-in, phone booking,
  // import) has a phone but no consent, and until now the ONLY way they
  // could ever be texted was to text the studio first -- the intake form
  // is public-only and the keyword paths are all inbound. These two carry
  // the self-serve half of the fix: a single-use link the client opens and
  // opts in on themselves, which is the strongest evidence a carrier
  // audit can be shown (the client's own action, not staff attesting on
  // their behalf). Same random-token + expiry shape as every other public
  // flow here (waiver, deposit, estimate), per CLAUDE.md's standing rule
  // that a new public flow reuses the established pattern rather than
  // inventing an auth mechanism.
  //
  // Single-use: both are cleared the moment consent is recorded, so a
  // forwarded or screenshotted link cannot be replayed against the client
  // later. Staff can always issue a fresh one.
  smsConsentToken          String?   @unique
  smsConsentTokenExpiresAt DateTime?

  // Transfer-to-artist epic: set once execution creates this client's
  // counterpart at the destination studio -- same exclude-from-list-views
  // pattern as archivedAt/mergedIntoId above, but (unlike a merge) the
  // record and its full history stay fully intact and queryable here,
  // it's just ended. Never cleared; a transfer is not reversible.
  transferredAt          DateTime?
  transferredToStudioId  String?
  transferredToStudio    Studio?    @relation("ClientTransferredToStudio", fields: [transferredToStudioId], references: [id])

  appointments      Appointment[]
  inquiries         Inquiry[]
  giftCards         GiftCard[]
  liabilityWaivers  LiabilityWaiver[]
  conversation      Conversation?
  phones            ClientPhone[]
  emails            ClientEmail[]
  // Package R: rows from a mass import whose duplicate-detection matched
  // THIS client -- purely informational (which import(s) proposed
  // merging into this client); nothing about this client's own fields is
  // affected by having one.
  matchedImportRows ImportRow[]
  // Transfer-to-artist epic: line items naming this client as either the
  // origin record being moved or the freshly-created destination record.
  transferLineItemsAsOrigin      ArtistTransferClient[] @relation("TransferLineItemOriginClient")
  transferLineItemsAsDestination ArtistTransferClient[] @relation("TransferLineItemDestinationClient")

  @@index([studioId])
  @@index([studioId, createdAt])
}

// Package R: mass client import -- a staged review before anything is
// actually written. Uploading a CSV creates one ImportRow per parsed
// line with its rawData preserved verbatim (status MAPPING); nothing is
// duplicate-checked or parsed yet because that requires a confirmed
// column mapping first (flexible-column-mapping revision). Once staff
// confirms columnMapping (PATCH .../mapping), the batch moves to
// PENDING_REVIEW and every row is processed (duplicate-detect + deposit
// parsing) in one pass. Nothing touches the real Client table until staff
// reviews every row, sets a decision, and confirms (POST .../execute).
model ImportBatch {
  id        String            @id @default(cuid())
  status    ImportBatchStatus @default(MAPPING)
  createdAt DateTime          @default(now())

  // Confirmed header -> target-field mapping for this batch, set once by
  // PATCH .../mapping and never changed afterward (a new mapping means a
  // new upload, not editing this one) -- see lib/importColumnMapping.ts
  // for the fixed set of target-field keys this can contain.
  // Record<originalCsvHeader, targetFieldKey>. Null while status: MAPPING.
  columnMapping Json?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  rows ImportRow[]

  @@index([studioId])
}

model ImportRow {
  id String @id @default(cuid())

  // The parsed CSV row, verbatim -- whatever columns were present, keyed
  // by their ORIGINAL (trimmed, un-aliased) header text. This is what the
  // review table renders; it's never partially applied to a Client until
  // execute time, and even then only fields the batch's confirmed
  // columnMapping actually assigns are read from it.
  rawData Json

  // Set once columnMapping is confirmed, by the existing per-client
  // duplicate-detection logic (see lib/duplicateDetection.ts), run
  // against this row's mapped phone/email -- null means no match was
  // found (or mapping isn't confirmed yet), not "not yet checked."
  matchedClientId String?
  matchedClient   Client? @relation(fields: [matchedClientId], references: [id])

  // Set once columnMapping is confirmed, by parsing whatever column was
  // mapped to depositAmount (see lib/importColumnMapping.ts's
  // parseDepositAmountCents -- handles "$", commas, and embedded text like
  // "Deposit Paid Online - $200"). Null means either no depositAmount
  // column was mapped, this row's cell was empty, or the value was
  // genuinely unparseable -- in every case treated as "no deposit for this
  // row," never guessed. Also the field a depositDecision: EDIT resolution
  // overwrites with the staff-supplied corrected amount (see below).
  parsedDepositCents Int?

  // True when parsedDepositCents fell well outside what the studio's own
  // configured deposit tiers (Package C1) imply as normal -- see
  // lib/importColumnMapping.ts's isDepositOutlier for the exact threshold.
  // Computed once at mapping-confirm time and never recomputed afterward
  // (even if depositDecision: EDIT changes parsedDepositCents) -- this
  // stays the historical fact "the originally parsed value looked
  // unusual," which is why review needed a human decision in the first
  // place.
  depositFlaggedAsOutlier Boolean @default(false)

  // Only ever required (and only ever settable) for a row with
  // depositFlaggedAsOutlier: true -- execute refuses to run while any
  // flagged row still has this null. Not used at all for a non-flagged
  // row's deposit, which needs no individual action.
  depositDecision ImportRowDepositDecision?

  // Set once columnMapping is confirmed (mass-import follow-up), by
  // matching whatever column was mapped to inquiry.assignedArtist against
  // the studio's own Artist display names -- see
  // lib/importArtistMatching.ts. Null means no artist column was mapped,
  // this row's cell was empty, or nothing matched closely enough. Unlike
  // a flagged deposit outlier, an unresolved/unreviewed artist match does
  // NOT block execute -- the inquiry still imports successfully,
  // unassigned, with the original raw text preserved in its historical
  // note as a fallback.
  matchedArtistId String?
  matchedArtist   Artist? @relation(fields: [matchedArtistId], references: [id])

  // True when the match above was either a fuzzy (not exact) match or no
  // match at all -- surfaced in the same review UI as a flagged deposit
  // outlier, so staff can confirm/correct/clear it, but purely advisory:
  // never recomputed after a staff pick, and never checked by execute.
  artistFlaggedForReview Boolean @default(false)

  // Null until staff reviews this specific row -- execute refuses to run
  // while any row in the batch is still null (see the route for the exact
  // error), rather than silently skipping undecided rows.
  decision    ImportRowDecision?
  processedAt DateTime?

  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id])

  @@index([importBatchId])
}

// Multiple named forms per studio (e.g. "Standard Inquiry," "Cover-up
// Consultation"), each with its own independent set of IntakeFormField
// rows. Every studio must always have exactly one isDefault: true form --
// enforced server-side (create/update/delete), never a DB constraint,
// same "application-layer invariant" convention as validateFieldListConstraint
// below. /inquiry/{studio-slug} (no form-slug segment) always resolves to
// whichever form is currently the default, so every already-shared link
// keeps working with zero disruption as new named forms are added.
model IntakeForm {
  id        String   @id @default(cuid())
  name      String
  // URL-safe, unique per studio (not globally -- unlike Studio.slug) --
  // set once at creation from the name and never changed afterward, same
  // "slug is immutable once assigned, since it may already be shared
  // publicly" convention Studio.slug itself follows.
  slug      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  fields    IntakeFormField[]
  inquiries Inquiry[]
  services  Service[]

  @@unique([studioId, slug])
  @@index([studioId])
}

// Service lines (multi-service support): what a studio actually offers,
// e.g. "Tattoo" (the pre-existing behavior, seeded once per studio by
// this feature's own backfill migration -- see
// 20260725_backfill_inquiry_service/migration.sql) and "Powder Brows"
// (the first real PMU case). Each service branches two independent things
// -- how its price is quoted (pricingModel) and how its deposit is
// computed (depositModel) -- and points at its own IntakeForm, so a
// service with materially different intake needs (e.g. PMU candidacy
// photos) gets a dedicated form without forking the whole intake pipeline.
enum ServicePricingModel {
  // Existing tattoo behavior: a low/high estimate range, entered by staff
  // per inquiry (Inquiry.priceEstimateLow/High) -- unaffected by this
  // model's existence.
  RANGE
  // A single flat price known up front (flatPriceCents) -- e.g. Powder
  // Brows. The existing estimate send/track/respond flow is reused
  // unchanged; only the input shape (one number instead of a range)
  // differs.
  FLAT
}

enum ServiceDepositModel {
  // Existing behavior: the required deposit is looked up from the
  // studio's configured deposit tiers (StudioSettings.depositTiers /
  // computeDepositTier) based on the estimate amount -- unaffected by
  // this model's existence.
  TIER_BASED
  // A single flat deposit amount (flatDepositCents), independent of the
  // estimate -- e.g. Powder Brows' $60 total ($50 deposit + $10
  // processing fee, per depositBreakdownNote).
  FLAT
}

model Service {
  id   String @id @default(cuid())
  name String
  slug String

  pricingModel ServicePricingModel
  depositModel ServiceDepositModel

  // Set only when pricingModel: FLAT / depositModel: FLAT respectively --
  // null for RANGE/TIER_BASED services (Tattoo). Both use the same "flat"
  // convention as every other money field in this schema: whole cents.
  flatPriceCents       Int?
  flatDepositCents     Int?
  // Shown to the client alongside the deposit total on the public deposit
  // page when set (e.g. "$50 deposit + $10 processing fee") -- purely
  // informational, never parsed or used in any calculation.
  depositBreakdownNote String?

  // When true, a new inquiry for this service lands in the
  // CANDIDACY_REVIEW status instead of proceeding straight to the normal
  // pricing/estimate stage -- see InquiryStatus and the candidacy-review
  // routes. False (Tattoo) never touches that status.
  requiresCandidacyReview Boolean @default(false)

  // Soft-disable, not a hard delete -- a service with real inquiries
  // attached can never be hard-deleted (enforced in routes/services.ts),
  // only deactivated. An inactive service stops appearing as a selectable
  // option for new inquiries/artist tagging but every existing row that
  // already references it (Inquiry.serviceId, ArtistService) is untouched.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  // Required -- unlike Inquiry.intakeFormId (permanently nullable, see that
  // field's own comment), every Service always has exactly one intake form
  // it was created with. Deleting an IntakeForm that a Service still
  // points at is blocked (ON DELETE RESTRICT, the default for a required
  // relation) rather than silently orphaning the service.
  intakeFormId String
  intakeForm   IntakeForm @relation(fields: [intakeFormId], references: [id])

  artistServices ArtistService[]
  inquiries      Inquiry[]

  // Multi-language public forms: see FlashPieceTranslation's own comment
  // for the sibling-table-vs-locale-columns reasoning (identical here).
  translations ServiceTranslation[]

  @@unique([studioId, slug])
  @@index([studioId])
}

// Multi-language public forms, Part 2 (schema only): a studio's own
// translation of a Service's client-facing name and deposit breakdown
// note. Same sibling-table pattern as FlashPieceTranslation -- see that
// model's comment for the full reasoning (unbounded one-to-many per
// studio, plain app-validated locale String, duplicated studioId).
model ServiceTranslation {
  id     String @id @default(cuid())
  locale String

  name                 String?
  depositBreakdownNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  @@unique([serviceId, locale])
  @@index([studioId, locale])
}

// Which artists offer which services -- e.g. only the one real PMU
// practitioner is tagged as offering Powder Brows, so practitioner pickers
// (wherever staff assign an artist to an inquiry) can filter to just the
// artists actually qualified for that inquiry's specific service. Backfilled
// once, for the "Tattoo" service only, by this feature's own migration --
// every existing Artist is tagged as offering Tattoo, since that's all any
// artist could have offered before this feature existed.
model ArtistService {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([artistId, serviceId])
  @@index([serviceId])
}

// Package Q (revised): one unified, ordered list per FORM (originally per
// studio, before multiple named forms existed -- see IntakeForm above),
// mixing two kinds of rows -- SYSTEM rows represent an existing, unchanging
// Inquiry/Client column (systemFieldKey identifies which one; the column
// itself never changes shape, only how the FORM presents it does), CUSTOM
// rows are studio-authored questions of their own. `order` alone controls
// display position on the public form -- system and custom rows are
// freely interleaved.
model IntakeFormField {
  id        String          @id @default(cuid())
  fieldKind IntakeFieldKind

  // Set only when fieldKind: SYSTEM. One of: name, email, phone,
  // referralSource, description, colorOrBlackGrey, placement, size,
  // hasBeenTattooedBefore, preferredArtist, budget, desiredTiming,
  // referenceImages, placementImages -- see lib/intakeFormFields.ts's
  // SYSTEM_FIELD_KEYS for the authoritative list.
  systemFieldKey String?

  // Set only when fieldKind: CUSTOM. Freely editable after creation (the
  // Settings editor's type dropdown already allowed this) -- a changed
  // type only affects future submissions; historical Inquiry.
  // customFieldAnswers snapshots keep their own originally-captured type
  // tag and render from that, never this live value (see
  // InquiryDetailsSection.tsx's formatCustomAnswer).
  customQuestionType IntakeCustomQuestionType?

  // SYSTEM: overrides the field's default display label (kept close to
  // the default unless a studio explicitly customizes it -- see the data
  // migration in this same package). CUSTOM: this IS the question text.
  label    String
  helpText String?

  required Boolean @default(false)
  // Whether this field shows on the public form at all -- name and at
  // least one of phone/email can never be false here (enforced server-
  // side on every write, not just in the Settings UI -- a studio needs
  // SOME way to identify and reach a submitter).
  enabled  Boolean @default(true)

  // Array<string> -- SELECT/MULTI_SELECT custom questions only.
  options Json?

  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  intakeFormId String
  intakeForm   IntakeForm @relation(fields: [intakeFormId], references: [id])

  // Multi-language public forms: see FlashPieceTranslation's own comment
  // for the sibling-table reasoning. Read-time fallback for a SYSTEM
  // field with no translation row is NOT simply this row's own (possibly
  // still-platform-default) `label`/`helpText` -- see
  // IntakeFormFieldTranslation's own comment for the seed-equality rule
  // that governs it instead.
  translations IntakeFormFieldTranslation[]

  @@index([studioId, order])
  @@index([intakeFormId, order])
}

// Multi-language public forms, Part 2 (schema only): a studio's own
// translation of one intake form field's label/helpText/options. Same
// sibling-table pattern as FlashPieceTranslation -- see that model's
// comment for the full schema reasoning.
//
// SEED-EQUALITY rule (Part 1 proposal, decision on review): this table
// alone is not enough to know whether a SYSTEM field's Spanish should
// come from the platform's own translated defaults or be left as "needs
// a studio translation." No new boolean/flag column for this -- it's
// computed at read time by comparing the parent IntakeFormField's live
// English `label`/`helpText` against the platform's own seed dictionary
// (lib/intakeFormFields.ts's SYSTEM_FIELD_DEFAULTS) for that
// systemFieldKey: byte-identical to the seed -> serve the platform's own
// Spanish default for that field key (shown in the Settings editor
// labeled "platform translation," overridable by writing a row here);
// the moment a studio edits the English away from the seed, this table
// becomes the sole source for that field, falling back to the studio's
// own (now-diverged) English until a row here is actually supplied. A
// CUSTOM field (never seeded, always studio-authored) always follows the
// plain fallback -- this row if present, else the studio's own English,
// never the platform seed.
model IntakeFormFieldTranslation {
  id     String @id @default(cuid())
  locale String

  label    String?
  helpText String?
  // Array<string> -- mirrors IntakeFormField.options' own shape.
  options  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intakeFormFieldId String
  intakeFormField   IntakeFormField @relation(fields: [intakeFormFieldId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  @@unique([intakeFormFieldId, locale])
  @@index([studioId, locale])
}

// Additive secondary-contact layer -- Client.phone stays the "primary"
// scalar field every existing consumer (intake form, waivers, duplicate
// detection, PhoneInput default) keeps reading unchanged. These tables
// exist purely so a client can have more than one phone/email on file;
// the row with isPrimary: true always mirrors Client.phone exactly (kept
// in sync by lib/clientContacts.ts, never diverges from it).
model ClientPhone {
  id        String   @id @default(cuid())
  phone     String
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, phone])
}

model ClientEmail {
  id        String   @id @default(cuid())
  email     String
  label     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  @@unique([clientId, email])
}

// Suppresses an automatic potential-duplicate suggestion for one specific
// pair -- staff decided these two clients are NOT the same person. Manual
// merge via the client-search picker stays available regardless (this only
// hides the pair from GET /clients/:id/potential-duplicates), since staff
// might reconsider later. clientAId/clientBId are always stored with the
// lexicographically smaller id first, so a pair is unique and matchable
// regardless of which of the two clients the dismiss action was fired from.
model DismissedDuplicatePair {
  id          String   @id @default(cuid())
  clientAId   String
  clientBId   String
  dismissedAt DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  dismissedById String
  dismissedBy   User   @relation(fields: [dismissedById], references: [id])

  @@unique([clientAId, clientBId])
  @@index([studioId])
}

// Transfer-to-artist epic: a departing artist's client contacts + a fresh
// open project carrying work state follow them to their new home studio.
// Everything signed, financial, or note-shaped stays at origin -- the
// origin Client/Inquiry rows resolve as ended (TRANSFERRED/transferredAt),
// never deleted, full history intact.
//
// Job/line-item split, same shape as ImportBatch/ImportRow above: this is
// the job (overall status, who initiated/responded/cancelled, when), each
// ArtistTransferClient is one line item. Execution loops per line item,
// each wrapped in its own transaction (Part 4) -- @@unique([transferId,
// originClientId]) below is the resume-safe idempotency key: an
// interrupted execution just re-runs the loop and skips any row whose
// outcome is no longer PENDING, same "processedAt as the already-handled
// marker" convention ImportRow already uses, no separate synthetic key
// column.
enum TransferStatus {
  PENDING_ARTIST
  ACCEPTED
  DECLINED
  CANCELLED_BY_ORIGIN
  COMPLETED
}

enum TransferLineItemOutcome {
  PENDING
  CREATED
  // Destination already has a matching contact (existing duplicate-
  // detection machinery, lib/duplicateDetection.ts) -- creation was
  // skipped, the standard merge suggestion is left for destination staff.
  // Never a silent auto-merge.
  MERGE_FLAGGED
  FAILED
}

model ArtistTransfer {
  id     String         @id @default(cuid())
  status TransferStatus @default(PENDING_ARTIST)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  originStudioId      String
  originStudio        Studio @relation("TransferOrigin", fields: [originStudioId], references: [id])
  destinationStudioId String
  destinationStudio   Studio @relation("TransferDestination", fields: [destinationStudioId], references: [id])

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  initiatedById String
  initiatedBy   User   @relation("TransferInitiatedBy", fields: [initiatedById], references: [id])

  // The artist's own User id, set on accept or decline.
  respondedById String?
  respondedBy   User?   @relation("TransferRespondedBy", fields: [respondedById], references: [id])

  cancelledById String?
  cancelledBy   User?   @relation("TransferCancelledBy", fields: [cancelledById], references: [id])

  lineItems ArtistTransferClient[]

  @@index([originStudioId])
  @@index([destinationStudioId])
  @@index([artistId])
  @@index([status])
}

model ArtistTransferClient {
  id         String         @id @default(cuid())
  transferId String
  transfer   ArtistTransfer @relation(fields: [transferId], references: [id])

  originClientId String
  originClient   Client  @relation("TransferLineItemOriginClient", fields: [originClientId], references: [id])
  // The specific open project carrying work state to the destination --
  // nullable, since a selected client need not have an open project with
  // this artist.
  originInquiryId String?
  originInquiry   Inquiry? @relation("TransferLineItemOriginInquiry", fields: [originInquiryId], references: [id])

  destinationClientId  String?
  destinationClient    Client?  @relation("TransferLineItemDestinationClient", fields: [destinationClientId], references: [id])
  destinationInquiryId String?
  destinationInquiry   Inquiry? @relation("TransferLineItemDestinationInquiry", fields: [destinationInquiryId], references: [id])

  outcome      TransferLineItemOutcome @default(PENDING)
  errorMessage String?
  processedAt  DateTime?

  @@unique([transferId, originClientId])
  @@index([transferId])
}

model Appointment {
  id              String            @id @default(cuid())
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(REQUESTED)
  // Defaulted NOT NULL, not backfilled -- every existing row is a real
  // tattoo session (consultations didn't exist before this column), so the
  // default IS the correct historical value for all of them, materializing
  // safely in a single-step migration (unlike Client.referralCode's own
  // earlier no-default incident, which genuinely needed a per-row backfill
  // script before the NOT NULL constraint could land).
  appointmentType AppointmentType   @default(TATTOO_SESSION)
  depositPaid     Boolean           @default(false)
  notes           String?
  createdAt       DateTime          @default(now())

  // Soft, reversible hide -- same exclude-from-list-views pattern as
  // Client.archivedAt / Inquiry.archivedAt. The record stays intact and
  // directly reachable via GET /:id; only the default list (which backs the
  // Calendar) excludes it.
  archivedAt DateTime?

  // Checkout (Phase 4): filled in together, at the end of the session, by
  // POST /appointments/:id/checkout. status moves to COMPLETED at the same
  // time -- COMPLETED already existed as a plain manual status option with
  // no other logic attached to it, so checkout formalizes what that value
  // already meant rather than repurposing something with different meaning.
  finalCostCents Int?
  // Tipping (embedded payments UX redesign): recorded distinctly from
  // finalCostCents (the service price) so it's never blended into the
  // service amount, and attributed to the artist via this same
  // appointment's existing artistId -- no separate attribution field
  // needed. null means the tip step never ran (pre-tipping appointments,
  // or embeddedPaymentsEnabled off); 0 means the client explicitly chose
  // no tip -- these two states must stay distinguishable, so no default.
  tipCents       Int?
  closeoutNotes  String?
  checkedOutAt   DateTime?
  checkedOutById String?
  checkedOutBy   User?     @relation("AppointmentCheckedOutBy", fields: [checkedOutById], references: [id])

  // Phase 7C: same real-charge-with-manual-fallback pattern as
  // DepositForm's own stripeCheckoutSessionId/stripePaymentIntentId/
  // paidVia -- covers the checkout-time "amount due" charge (ROLL, or
  // REDEEM where the card is worth less than finalCostCents), not the
  // deposit itself.
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  paidVia                 String?

  // Phase 7B-2: per-appointment dedup for the client reminder cadence (one
  // week before, night before, morning of) -- each is set once its own
  // reminder actually sends, so the ticker never double-sends the same
  // reminder type for the same appointment across multiple 15-minute ticks.
  reminderWeekSentAt        DateTime?
  reminderNightBeforeSentAt DateTime?
  reminderMorningOfSentAt   DateTime?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // One project (Inquiry) has many sessions (Appointment) -- distinct from
  // Inquiry.appointmentId below, which is the older 1:1 "scheduled slot"
  // link from the original scheduling flow. Required as of Phase 3: both
  // appointment-creation routes (standalone and /inquiries/:id/schedule)
  // now populate it, and every appointment must have one.
  inquiryId      String
  inquiryProject Inquiry @relation("InquirySessions", fields: [inquiryId], references: [id])

  inquiry         Inquiry?           @relation("InquiryScheduledAppointment")
  // Stackable gift cards: several can attach to one appointment now (was a
  // to-one GiftCard? before this package, enforced by GiftCard.appointmentId
  // being @unique).
  giftCards       GiftCard[]
  liabilityWaiver LiabilityWaiver?
  photos          AppointmentPhoto[]
  // Manually-written staff commentary on this specific session -- named
  // noteEntries (not `notes`) to avoid colliding with the existing scalar
  // `notes` field above (a single free-text field set at booking time,
  // left untouched). Same InquiryNote pattern/model shape, one row per
  // AppointmentNote model below.
  noteEntries     AppointmentNote[]
  // Reverse side of PlannedSession.appointmentId -- set once this
  // appointment was booked to fulfill a specific planned session (staff
  // picked one in AppointmentForm) rather than an un-planned/ad-hoc
  // booking. Null for every appointment on a project with no session
  // plan at all, and for any ad-hoc extra session booked outside the plan.
  plannedSession  PlannedSession?

  @@index([studioId, startTime])
  @@index([inquiryId])
  @@index([studioId, createdAt])
  @@index([artistId, createdAt])
}

// Package N: finished-tattoo (or other checkout-time) photos for one
// session. Reuses the existing Cloudinary signed-upload flow (same as
// intake reference/placement images, waiver ID photos) -- this table only
// ever stores the resulting secure_url, never handles the upload itself.
model AppointmentPhoto {
  id         String   @id @default(cuid())
  url        String
  uploadedAt DateTime @default(now())

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  // Nullable so a finished-tattoo photo survives if the staff member who
  // uploaded it is later deleted -- the photo is real client-facing
  // content, unlike the account that happened to upload it.
  uploadedById String?
  uploadedBy   User?   @relation("AppointmentPhotoUploadedBy", fields: [uploadedById], references: [id])

  @@index([appointmentId])
}

model Inquiry {
  id                    String        @id @default(cuid())
  channel               Channel
  description           String
  colorOrBlackGrey      String
  placement             String
  estimatedSize         String
  hasBeenTattooedBefore Boolean
  budget                String?
  desiredTiming         String?
  referenceImages       String[]
  placementImages       String[]
  // Sidecar upload metadata, tracked going forward only -- referenceImages/
  // placementImages themselves stay plain URL arrays (touched by too many
  // call sites -- the public intake form, the staff create form, this same
  // route's create/PATCH handlers, the read-only Project view, and list-
  // view thumbnails -- to justify migrating to a real per-image table).
  // Record<url, { uploadedAt: ISO string, uploadedById: string | null }>;
  // uploadedById null means the client submitted it themselves (the public
  // intake form has no authenticated staff user to attribute it to). A url
  // with no entry here predates this feature -- shown as "no data" in the
  // UI, never backfilled, since who uploaded it was genuinely never
  // recorded.
  referenceImagesMeta   Json?
  placementImagesMeta   Json?
  // Answers to the studio's CUSTOM IntakeFormField questions at the
  // moment THIS inquiry was submitted -- a self-contained snapshot
  // (question text + type + answer, not just a bare value), keyed by the
  // IntakeFormField's id, so editing or removing a question later never
  // changes what an already-submitted inquiry displays. Never populated
  // by any route besides the one that creates this row. Shape/semantics
  // unchanged by Package Q's revision -- only where the question
  // definitions now live (IntakeFormField, not StudioSettings) changed;
  // this is why the original Package Q's id-preservation during migration
  // mattered so much (see the IntakeFormField model's own comment).
  // Record<string, { question: string, type: string, answer: string | string[] }>
  customFieldAnswers    Json?
  status                InquiryStatus @default(NEW)
  priceEstimateLow      Float?
  priceEstimateHigh     Float?
  // Deprecated: superseded by timeEstimateHoursMin/Max below, which make
  // the time estimate a real range (consistent with the price range) --
  // kept for historical rows, no longer written to by any route.
  timeEstimateHours     Float?
  timeEstimateHoursMin  Float?
  timeEstimateHoursMax  Float?
  declineNote           String?
  createdAt             DateTime      @default(now())
  // Phase 7A: didn't exist before this phase. Added specifically as one of
  // the four last-activity signals the cold-lead sweep considers (see
  // lib/jobs/coldLeadSweep.ts) -- Prisma maintains it automatically on
  // every update() call, no route needs to set it explicitly.
  updatedAt             DateTime      @updatedAt
  assignedAt            DateTime?

  // Token-lifecycle bug fix: NO LONGER cleared on response when the
  // response issues a selfScheduleToken (PROCEED + self-scheduling
  // eligible) -- the client's only durable link IS this one (no separate
  // self-schedule URL is ever sent to them, only reached via an in-browser
  // redirect), so it needs to stay resolvable for as long as self-
  // scheduling is genuinely still pending. GET /estimates/verify/:token
  // detects the already-responded case (estimateRespondedAt set) and
  // switches to self-scheduling-phase logic -- redirect info, an
  // already-booked message, or expiry keyed off selfScheduleTokenExpiresAt
  // instead of this field's own. Cleared exactly as before (immediately,
  // unconditionally) for every OTHER decision/ineligible case -- nothing
  // further for that client to reach, so single-use stays single-use.
  estimateToken          String?   @unique
  estimateTokenExpiresAt DateTime?
  estimateSentAt         DateTime?
  estimateOpenedAt       DateTime?
  estimateRespondedAt    DateTime?
  // Phase 7B-2: set once the 24-hour-after-opened follow-up text actually
  // sends. Reset to null wherever estimateOpenedAt/estimateRespondedAt
  // already get reset on a resend (POST /:id/send-estimate) -- a resent
  // estimate is a new estimate event, and the old follow-up shouldn't
  // block a fresh one from ever firing again.
  estimateFollowUpSentAt DateTime?
  // The studio's estimate T&C text exactly as it was when this estimate was
  // sent, so a later edit to StudioSettings.estimateTerms never retroactively
  // changes what a client already saw/agreed to.
  estimateTermsSnapshot  String?
  // Multi-language public forms: which locale was showing when the client
  // actually responded to this estimate -- estimateTermsSnapshot above
  // already captures the exact text verbatim regardless of locale; this
  // just records which language that text was in, for PDF/audit display.
  // Plain, app-validated String, not an enum -- same reasoning as
  // Client.preferredLocale.
  signedLocale           String?
  clientStatedBudget     String?
  closedReason           String?
  // Phase 7A: set only by POST /:id/mark-lost (a deliberate staff action),
  // distinct from closedReason above which predates this phase and is left
  // untouched. Cleared by /:id/reopen. Not set by the cold-lead sweep --
  // that path is fully automated and has no human-entered reason.
  lostReason             String?
  lostAt                 DateTime?

  // Prepay + On-Hold epic, Part 1: paired with InquiryStatus.ON_HOLD,
  // same out-of-band-fields-alongside-a-status shape as lostAt/lostReason
  // above. statusBeforeHold is what release restores `status` back to --
  // captured at the moment of going on hold, not derived after the fact,
  // since by then `status` itself is already ON_HOLD and the prior stage
  // would otherwise be lost. holdReason is optional, same "staff may or
  // may not explain why" convention as lostReason.
  statusBeforeHold       InquiryStatus?
  holdReason             String?
  heldAt                 DateTime?

  // Staff revising the estimate on an already-converted Project
  // (SCHEDULING/WAITLISTED/CONFIRMED/DEPOSIT_PENDING) -- distinct from
  // estimateToken/estimateOpenedAt/estimateRespondedAt above, which govern
  // the pre-conversion first-estimate approval flow (PROCEED -> DEPOSIT_
  // PENDING). A revision on a Project must NOT change `status` -- it's
  // already scheduled/deposited, so these fields track the customer's
  // response to the *change* separately, without touching the Project's
  // real lifecycle status. Every revision overwrites these (only the
  // latest revision's pending-approval state matters); full history of
  // every past revision -- old values, new values, staff's reason -- lives
  // permanently in AuditLog via the "estimate_revised" action instead of a
  // dedicated revision-history table.
  estimateRevisionReason         String?
  estimateRevisionToken          String?   @unique
  estimateRevisionTokenExpiresAt DateTime?
  estimateRevisionSentAt         DateTime?
  estimateRevisionRespondedAt    DateTime?
  // null = no response yet, true = customer approved, false = customer
  // flagged/objected (staff follow-up needed -- nothing auto-cancels the
  // deposit/schedule).
  estimateRevisionApproved       Boolean?

  // Client self-scheduling exploration: same crypto-random-token +
  // expiry + verify/respond-route pattern as estimateToken/
  // estimateRevisionToken above, issued alongside (never instead of)
  // the normal PROCEED -> DEPOSIT_PENDING transition, only when the
  // assigned artist has opted in (see Artist.allowsClientSelfScheduling)
  // and this inquiry has a usable single-session time estimate.
  //
  // Token-lifecycle bug fix: NO LONGER cleared on a completed booking --
  // that used to destroy the only lookup path to this record, so a client
  // revisiting their own just-used link after booking got a bare "invalid"
  // 404 instead of a real "you're all set" message. selfScheduleBookedAt
  // below is now the sole source of truth for "is this done"; the token
  // itself stays resolvable (a real Appointment already exists regardless,
  // so nothing security-sensitive is still reachable through it once
  // selfScheduleBookedAt is set -- see selfSchedule.ts's own routes,
  // which all check that field FIRST, before any expiry/token-match logic).
  selfScheduleToken          String?   @unique
  selfScheduleTokenExpiresAt DateTime?
  // Set once, at the moment PATCH /self-schedule/respond/:token actually
  // creates the Appointment -- never cleared. The one authoritative
  // "self-scheduling is done" signal (see selfScheduleToken's own comment
  // on why the token's mere presence/nullness stopped being that signal).
  selfScheduleBookedAt       DateTime?
  // Token-lifecycle bug fix, resend support: holds the IMMEDIATELY prior
  // selfScheduleToken value whenever a fresh one supersedes a still-live,
  // not-yet-booked one (see POST /:id/revise-estimate's own self-
  // scheduling-aware branch) -- lets GET /self-schedule/verify/:token tell
  // a client on a since-superseded link "a newer link was sent" instead of
  // a bare "invalid," in the edge case they still have that old tab open.
  previousSelfScheduleToken  String?   @unique

  // Token-lifecycle bug fix: holds the IMMEDIATELY prior estimateToken
  // value whenever POST /inquiries/:id/send-estimate issues a fresh one on
  // a genuine resend (before the client has responded at all) -- same
  // "show a newer-link message, not a bare invalid" purpose as
  // previousSelfScheduleToken above, for the estimate phase instead of the
  // self-scheduling phase.
  previousEstimateToken String? @unique

  // Soft, reversible hide -- same pattern as Client.archivedAt.
  archivedAt DateTime?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  preferredArtistId String?
  preferredArtist   Artist? @relation("PreferredArtist", fields: [preferredArtistId], references: [id])

  assignedArtistId String?
  assignedArtist   Artist? @relation("AssignedArtist", fields: [assignedArtistId], references: [id])

  // Older 1:1 "scheduled slot" link from the original scheduling flow.
  appointmentId String?      @unique
  appointment   Appointment? @relation("InquiryScheduledAppointment", fields: [appointmentId], references: [id])

  // Newer 1:many "sessions under this project" link -- see Appointment.inquiryId.
  sessions Appointment[] @relation("InquirySessions")

  // Package M: one per tattoo session, no longer a single optional 1:1.
  depositForms DepositForm[]

  // Multi-session planning: purely additive, optional layer on top of the
  // above -- an inquiry with none of these behaves exactly as it always
  // has (single top-level timeEstimateHoursMin/Max, one implicit
  // "session"). Only populated when staff explicitly declares more than
  // one session at estimate time (POST /:id/send-estimate's `sessions`
  // array) -- see PlannedSession's own comment for why.
  plannedSessions PlannedSession[]

  notes InquiryNote[]

  // Which of the studio's (possibly several) named intake forms this
  // inquiry was submitted through -- nullable PERMANENTLY, unlike
  // IntakeFormField.intakeFormId above. Historical inquiries genuinely
  // don't have this information (they predate multiple forms existing at
  // all) and that's fine -- no backfill attempted or needed. Deleting the
  // IntakeForm this points at nulls this out (ON DELETE SET NULL, the
  // default for a nullable relation) rather than blocking the delete or
  // touching the inquiry's own real submitted data.
  intakeFormId String?
  intakeForm   IntakeForm? @relation(fields: [intakeFormId], references: [id])

  // Service lines (multi-service support): which of the studio's services
  // this inquiry is for (e.g. "Tattoo" or "Powder Brows") -- drives
  // pricing model (RANGE vs FLAT), deposit model (TIER_BASED vs FLAT), and
  // whether this inquiry passes through CANDIDACY_REVIEW before the normal
  // pricing stage. Required as of 20260725153500_inquiry_service_id_required
  // -- every pre-existing row was backfilled to its studio's new "Tattoo"
  // service by 20260725153000_backfill_inquiry_service first (nullable ->
  // backfilled -> required, this schema's standing migration discipline),
  // unlike Inquiry.intakeFormId above which stays nullable permanently.
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  // Project pipeline timeline's final, explicitly-set stage -- NOT derived
  // from session/checkout state (see InquiryDetail.tsx's
  // deriveProjectStageIndex). Null means "not yet marked complete." Set by
  // POST /inquiries/:id/complete-project, cleared by the reopen
  // counterpart -- same "explicit action + explicit reversal, both
  // audited" pattern as lostAt/lostReason's own mark-lost/reopen pair, not
  // auto-inferred even when every session is already checked out.
  projectCompletedAt   DateTime?
  projectCompletedById String?
  projectCompletedBy   User?     @relation("ProjectCompletedBy", fields: [projectCompletedById], references: [id])

  // Flash gallery: set only by POST /flash-pieces/:id/request, never by
  // either normal intake form. The clear marker this inquiry is flash-
  // sourced (paired with Channel.FLASH_GALLERY above) -- artist/price/
  // duration all came from the piece, not staff assignment/estimation, so
  // InquiryPipeline.tsx renders a shorter stepper when this is set (see
  // that component's own comment). Deliberately NOT unique -- a repeatable
  // (isOneOfOne: false) piece can be the source of many different
  // inquiries over time, one per customer who requests it.
  flashPieceId String?
  flashPiece   FlashPiece? @relation(fields: [flashPieceId], references: [id])

  // Flash gallery, Part 3: full prepayment, a distinct mechanism from the
  // deposit-tier gift-card system above (no gift card is issued here --
  // POST /flash-pieces/:id/request already fixed price/duration, so
  // there's nothing left to redeem against later). flashPaymentToken is
  // generated by POST /inquiries/:id/flash/approve (same crypto-token
  // pattern as every other public-flow token on this model) and text'd to
  // the client; stripeCheckoutSessionId/stripePaymentIntentId are this
  // model's own copies of the same fields DepositForm/Appointment/GiftCard
  // each carry independently, letting webhooks.ts's existing sequential
  // stripeCheckoutSessionId lookup gain a fourth branch with no shared-
  // table refactor. flashPaidAt is set by that webhook, never earlier --
  // it's what makes the payment-confirmation idempotent on retry.
  flashPaymentToken          String?   @unique
  flashPaymentTokenExpiresAt DateTime?
  flashPaidAt                DateTime?
  stripeCheckoutSessionId    String?   @unique
  stripePaymentIntentId      String?

  // Transfer-to-artist epic: paired with InquiryStatus.TRANSFERRED, same
  // out-of-band-fields-alongside-a-terminal-status shape as
  // lostAt/lostReason next to CLOSED_LOST. transferredToInquiryId points at
  // the fresh Inquiry execution created at the destination studio.
  transferredAt           DateTime?
  transferredToStudioId   String?
  transferredToStudio     Studio?   @relation("InquiryTransferredToStudio", fields: [transferredToStudioId], references: [id])
  transferredToInquiryId  String?   @unique
  transferredToInquiry    Inquiry?  @relation("InquiryTransferPair", fields: [transferredToInquiryId], references: [id])
  transferredFromInquiry  Inquiry?  @relation("InquiryTransferPair")
  // Line items naming this project as either the origin work state being
  // carried over, or the freshly-created destination project.
  transferLineItemsAsOrigin      ArtistTransferClient[] @relation("TransferLineItemOriginInquiry")
  transferLineItemsAsDestination ArtistTransferClient[] @relation("TransferLineItemDestinationInquiry")

  @@index([studioId])
  @@index([studioId, status])
  @@index([clientId])
  @@index([studioId, createdAt])
  @@index([assignedArtistId, createdAt])
  @@index([flashPieceId])
}

// Manually-written staff commentary log on an inquiry -- deliberately
// separate from AuditLog (system-generated, one row per state change,
// never hand-authored) and rendered as its own distinct feed, never
// merged into the audit trail display. bodyHtml is stored raw, exactly
// like every other rich-text field in this schema (CustomPolicy,
// StudioSettings' policy fields) -- sanitization happens entirely
// client-side at render time via sanitizeHtml.ts, never on write.
// Replaces the old single-field Inquiry.notes (one unauthored, untimed
// text blob) -- the one inquiry that had real content in that field was
// migrated into a note here (authored by that studio's OWNER, timestamped
// at the inquiry's own updatedAt, prefixed "Migrated from the previous
// single-note field:") before the old column was dropped.
model InquiryNote {
  id        String   @id @default(cuid())
  bodyHtml  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Staff-set, per-note -- default false so every existing note (and every
  // new one unless the author opts in) stays exactly as private as
  // NotesSection.tsx's own original design intended ("never shown to the
  // client or shared with an artist"). Only notes with this true are
  // returned to the assigned artist via ARTIST_INQUIRY_SELECT
  // (routes/inquiries.ts) -- the staff-facing GET/POST/PATCH routes are
  // unaffected and always see every note regardless of this flag.
  visibleToArtist Boolean @default(false)

  // Array<{url, filename, mimeType}> -- unlike Message.attachments (bare
  // Cloudinary URLs, images only, uploaded via the image/upload endpoint),
  // note attachments can be any file type (uploaded via Cloudinary's
  // auto/upload instead), so each entry also carries the original
  // filename/mimeType for a file-icon + name display whenever it isn't an
  // image the frontend can just render as a thumbnail.
  attachments Json?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id])

  // Nullable so a note about a client's project survives if its author is
  // later deleted from the studio -- the note content is real business
  // record, unlike the account that wrote it.
  authorId String?
  author   User?   @relation("InquiryNoteAuthor", fields: [authorId], references: [id])

  @@index([studioId])
  @@index([inquiryId, createdAt])
}

// Same shape and purpose as InquiryNote above, one level down -- manually-
// written staff commentary scoped to a single Appointment (session), not
// the whole Inquiry/project. Kept as its own model rather than widening
// InquiryNote with a nullable appointmentId: a note about "this specific
// 2pm session" and a note about "the whole back-piece project" are
// different scopes, and a client can have many Appointments per Inquiry.
model AppointmentNote {
  id        String   @id @default(cuid())
  bodyHtml  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same shape/reasoning as InquiryNote.attachments above.
  attachments Json?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  // Nullable for the same reason as InquiryNote.authorId -- survives its
  // author's deletion from the studio.
  authorId String?
  author   User?   @relation("AppointmentNoteAuthor", fields: [authorId], references: [id])

  @@index([studioId])
  @@index([appointmentId, createdAt])
}

model StudioSettings {
  id                            String   @id @default(cuid())
  refundPolicy                  String?
  depositPolicy                 String?
  reschedulePolicy              String?
  communicationPolicy           String?
  estimateFollowUpHours         Int      @default(24)
  estimateTerms                 String?
  giftCardDefaultExpirationDays Int?
  calendarInviteTemplate        String?
  // A2P 10DLC compliance: public, unauthenticated /privacy/:studioSlug and
  // /terms/:studioSlug pages render these (sanitized, same as every other
  // HTML policy field here). Not legal advice -- the seeded default text is
  // a reasonable starting point flagged for a lawyer's review, same caveat
  // as every other policy field in this app.
  privacyPolicy                 String?
  termsAndConditions            String?
  // Phase 7A: daily jobs (gift-card expiration, cold-lead sweep) compute
  // "the day" per-studio using this rather than the server process's own
  // TZ. IANA identifier (e.g. "America/New_York"). Also reserved for the
  // next phase's SMS send-window computation.
  timezone                      String   @default("America/New_York")
  // Phase 7A: days of no activity (see coldLeadSweep.ts's last-activity
  // definition) before a pre-conversion inquiry is auto-marked COLD_LEAD.
  coldLeadDays                  Int      @default(90)
  // Conversation composer templates (Phase 6A). Array<{ id: string, name: string, body: string }>.
  messageTemplates              Json?
  // Liability waiver template (Phase 4), editable by OWNER from Settings.
  // Array<{ question: string, type: "yes_no" | "yes_no_explain", explainPrompt?: string }>
  waiverHealthQuestions         Json?
  // DEPRECATED (Package Q revised): superseded by the IntakeFormField
  // table, which handles both system and custom fields in one unified,
  // reorderable list. No longer read or written by any route as of this
  // session -- every studio's existing entries here were migrated into
  // CUSTOM IntakeFormField rows (same ids preserved, so historical
  // Inquiry.customFieldAnswers still resolve). Left in place, unused,
  // rather than dropped -- lower risk than a schema removal under time
  // pressure right after the production incident this session followed.
  // Array<{ id: string, question: string, type: "text" | "yes_no" | "select",
  // options?: string[], required: boolean, order: number }>
  intakeCustomQuestions         Json?
  // Array<string>, exactly 10 clauses in display/initialing order.
  waiverClauses                 Json?
  waiverAcknowledgment          String?
  waiverPhotoRelease            String?
  // UI-1 §7: sidebar new-item count bubbles (Phase 5's SectionSeen-driven
  // badges) are opt-in, default off. When false, the frontend neither
  // renders bubbles nor fires POST /nav-counts/seen -- doesn't affect the
  // conversations unread badge (ConversationRead-driven) or the Tasks
  // top-bar badge, both unconditional.
  showSidebarBadges             Boolean  @default(false)
  // Calendar grey-shading (studio-closed source). Same shape family as
  // Artist.preferredSchedule, one entry per weekday.
  // Array<{ dayOfWeek: 0-6 (0 = Sunday), isOpen: boolean, openTime?: "HH:MM", closeTime?: "HH:MM" }>
  // Null/missing day = treated as closed (never silently "open all day").
  businessHours                 Json?
  // Phase 7B-2: plain-text SMS templates for the automated reminder
  // cadence -- deliberately separate from messageTemplates above (that's
  // the composer's own manual "insert template" menu, a different
  // concept). Shape: { clientWeekBefore, clientNightBefore, clientMorningOf,
  // artistDayBefore, estimateFollowUp, optInConfirmation, helpResponse },
  // each a plain string with {{placeholder}} tokens filled in at send
  // time. The last two are Twilio inbound-keyword auto-replies (sent from
  // routes/webhooks.ts on a matched START/YES/UNSTOP or HELP message, not
  // on the ticker's 15-minute cadence) -- same shape/editor, different
  // trigger, added specifically so they're never silently missing.
  reminderTemplates             Json?
  // Shape: { weekBeforeTime, nightBeforeTime, morningOfTime,
  // artistDayBeforeTime }, each "HH:MM" in this studio's own timezone
  // (see the `timezone` field above) -- checked against
  // isWithinSendWindow (lib/reminderWindow.ts) by the 15-minute ticker.
  reminderSendTimes             Json?
  // Package C1: configurable deposit-tier lookup, replacing the previously
  // hardcoded breakpoints in computeDepositTier (apps/api/src/routes/
  // inquiries.ts). Array<{ minAmountCents: number, maxAmountCents: number |
  // null, depositAmountCents: number }>, ordered ascending by minAmountCents;
  // maxAmountCents: null marks the top, catch-all tier -- exactly one tier
  // must have it, enforced by validateDepositTiers at PATCH time, not by
  // the schema. Nullable only because existing rows predate this column;
  // the migration backfills every existing studio with its literal prior
  // hardcoded behavior, and computeDepositTier falls back to that same
  // default list if a studio somehow still has null here.
  depositTiers                  Json?
  // Package C2: one of a fixed, curated set of theme presets (see
  // apps/api/src/lib/themePresets.ts's THEME_PRESET_KEYS) -- never
  // free-form. Editorial Gold is the canonical default for every new
  // studio; onyx-lime and the others remain fully real, OWNER-selectable
  // presets, just no longer the fallback a studio lands on before ever
  // touching Settings.
  themePreset                   String   @default("editorial-gold")
  // Package O: the reward issued to a referrer once the client they
  // referred pays their first deposit. $25 default matches the task's own
  // spec; OWNER-editable like every other numeric default on this model.
  referralRewardAmountCents     Int      @default(2500)
  // Master on/off for the whole referral program -- defaults true, since
  // every studio already has this running today (referral codes are
  // already generated for every client, "A friend referred them" is
  // already a channel option); this flag is what lets a studio that
  // doesn't want to run one turn it off, rather than a behavior change
  // landing silently for everyone. Off: the REFERRAL channel option is
  // rejected outright on intake (POST /inquiries), no new reward is ever
  // issued (lib/deposits.ts) even for a referredByClientId relationship
  // that already existed before this was turned off, and the client-
  // facing "share your code" callouts (deposit-paid page, checkout-
  // complete panel) stay hidden. Referral CODE GENERATION itself is left
  // unconditional either way (see referrals.ts) -- it's free, and turning
  // the program back on later means every client can immediately share
  // the code they already have, with nothing to backfill.
  referralProgramEnabled        Boolean  @default(true)
  // Redeemer-per-code reuse: false (default, the standard referral-program
  // norm) matches today's exact pre-existing behavior -- a specific
  // referred client's own relationship with their referrer can earn a
  // reward at most once, ever (see lib/deposits.ts's referralRewardIssuedAt
  // gate). true relaxes that to "once per separate project" -- a later,
  // unrelated visit (a new Inquiry) from that same referred client can earn
  // their referrer another reward on THAT project's own first paid
  // deposit. Governs reuse by the SAME redeemer only -- a code being used
  // by many different people is already unlimited regardless of this flag.
  referralAllowRepeatRedemption Boolean  @default(false)
  // Embedded payments migration: per-studio opt-in for the in-app Payment
  // Element (deposit/flash-prepayment/session-checkout all gate on this
  // same flag). Defaulted true as of the platform-wide rollout -- every
  // studio's client-facing payment flow uses the embedded Payment Element
  // now, both existing studios (backfilled by a one-off production update)
  // and every studio created from here on (this default covers it, since
  // both studio-creation paths -- createStudioWithOwner and go-solo --
  // eagerly create this row at creation time rather than relying on
  // getOrCreateSettings' lazy fallback). The field itself stays as the
  // rollback lever: flip it false for one studio to force hosted Stripe
  // Checkout, which remains fully intact as a fallback. Stripe Connect
  // mechanics (Standard, direct charges, application_fee_amount) are
  // identical either way -- this only changes where the customer types
  // their card number, never who's charged or how fees are split.
  embeddedPaymentsEnabled       Boolean  @default(true)
  // Settings "Defaults" tab audit: three more values that were previously
  // hardcoded constants (see REPORT.md's Part 1 proposal), now studio-level
  // defaults on the same model, same pattern as every field above --
  // defaults exactly match the prior hardcoded behavior so no existing
  // studio's behavior changes until an OWNER edits one.
  //
  // Was SCHEDULING_BUFFER_MS (lib/schedulingConflict.ts), a flat 1.5h --
  // now 90 minutes, the same value in a friendlier unit for a numeric input.
  schedulingBufferMinutes       Int      @default(90)
  // Was DEPOSIT_FEE_CENTS (lib/depositTiers.ts), a flat $10 stacked on top
  // of every tier-based deposit regardless of the (already-configurable)
  // tier amounts themselves.
  depositFeeCents               Int      @default(1000)
  // Was a hardcoded `daysOut: 7` / `1` at each sendClientReminders(...)
  // call site in lib/jobs/reminderTicker.ts -- the reminder cadence's send
  // TIME (reminderSendTimes above) and message TEXT (reminderTemplates)
  // were already configurable, which day wasn't. "Morning of" stays fixed
  // at 0 days -- see REPORT.md for why that one wasn't made configurable.
  reminderWeekBeforeDays        Int      @default(7)
  reminderNightBeforeDays       Int      @default(1)
  // Phase 5: studio-level, ARTIST-effective-role field visibility on
  // Inquiry/Project responses -- extends the pre-existing hardcoded
  // ARTIST_INQUIRY_SELECT projection (routes/inquiries.ts) with two
  // studio-configurable toggles on top of it, never a replacement for its
  // own already-reduced baseline. Null/missing keys default to `true`
  // (current, pre-feature behavior) -- see
  // lib/artistFieldVisibility.ts's own DEFAULT_ARTIST_FIELD_VISIBILITY,
  // the single source of truth for these defaults and key names.
  // Shape: { pricingDetail?: boolean, internalNotes?: boolean }
  artistFieldVisibility         Json?
  // Multi-language public forms: what a brand-new client with no
  // Client.preferredLocale of their own sees first on any public flow --
  // lets an all-Spanish-speaking-clientele studio default to Spanish
  // rather than making every client opt in individually. Plain,
  // app-validated String (against SUPPORTED_LOCALES), not an enum, same
  // reasoning as themePreset above. "en" matches every existing studio's
  // current, unchanged behavior.
  defaultLocale                 String   @default("en")
  // Prepay + On-Hold epic, Part 1: which DepositAmountMode a new deposit
  // form starts on when staff generate one -- staff can still override
  // per-send (Part 2), this only sets the pre-selected default. DEPOSIT
  // matches every studio's current, unchanged behavior.
  defaultDepositAmountMode      DepositAmountMode @default(DEPOSIT)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  studioId String @unique
  studio   Studio @relation(fields: [studioId], references: [id])

  // Multi-language public forms: studio-authored translations of the
  // free-text policy/waiver/estimate fields above. One row per locale
  // this studio has translated any of them into -- see
  // StudioSettingsTranslation's own comment.
  translations StudioSettingsTranslation[]
}

// Multi-language public forms, Part 2 (schema only): a studio's own
// translation of its free-text StudioSettings fields, one row per
// locale. Mirrors the base model's own translatable fields 1:1. Same
// sibling-table pattern as every other translation model in this
// package -- see FlashPieceTranslation's comment for the full reasoning
// (StudioSettings itself is 1:1 with Studio, but locale-keyed columns
// were still rejected here for consistency with every other content
// type and because it's the same "migration per language" problem the
// moment a third language is added). Fallback-to-default when a field
// here is null follows the exact pattern already used elsewhere in this
// schema (e.g. `themePreset ?? DEFAULT_THEME_PRESET`): each field falls
// back to its own StudioSettings column independently, not the whole
// row at once -- a studio might translate privacyPolicy but not
// refundPolicy yet.
model StudioSettingsTranslation {
  id     String @id @default(cuid())
  locale String

  refundPolicy          String?
  depositPolicy         String?
  reschedulePolicy      String?
  communicationPolicy   String?
  estimateTerms         String?
  // Mirrors StudioSettings.waiverHealthQuestions' own shape:
  // Array<{ question: string, type: "yes_no" | "yes_no_explain", explainPrompt?: string }>
  waiverHealthQuestions Json?
  // Mirrors StudioSettings.waiverClauses' own shape: Array<string>.
  waiverClauses         Json?
  waiverAcknowledgment  String?
  waiverPhotoRelease    String?
  privacyPolicy         String?
  termsAndConditions    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studioSettingsId String
  studioSettings   StudioSettings @relation(fields: [studioSettingsId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  @@unique([studioSettingsId, locale])
  @@index([studioId, locale])
}

// Package C1: add-your-own policy beyond the 8 fixed StudioSettings HTML
// fields -- same WYSIWYG edit pattern (RichTextEditor.tsx), same
// sanitizeHtml.ts allow-list applied on render, but an open-ended list
// instead of fixed keys. isPublic gates visibility on the public /policies
// page; a policy can exist (and be edited) while isPublic is false, it's
// just not listed there.
model CustomPolicy {
  id        String   @id @default(cuid())
  title     String
  bodyHtml  String?
  isPublic  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  // Multi-language public forms: see FlashPieceTranslation's own comment
  // for the sibling-table reasoning.
  translations CustomPolicyTranslation[]

  @@index([studioId])
}

// Multi-language public forms, Part 2 (schema only): a studio's own
// translation of one CustomPolicy's title/body. Same sibling-table
// pattern as FlashPieceTranslation -- see that model's comment for the
// full reasoning.
model CustomPolicyTranslation {
  id     String @id @default(cuid())
  locale String

  title    String?
  bodyHtml String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customPolicyId String
  customPolicy   CustomPolicy @relation(fields: [customPolicyId], references: [id], onDelete: Cascade)

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  @@unique([customPolicyId, locale])
  @@index([studioId, locale])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  changes    Json?
  createdAt  DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  // Null actor means a public/unauthenticated or system action (e.g. a
  // client signing a public token link), not a missing/deleted user.
  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id])

  @@index([studioId, entityType, entityId])
  @@index([studioId, createdAt])
}

// Multi-session planning: an optional, explicit session-by-session plan
// declared at estimate time (POST /inquiries/:id/send-estimate's
// `sessions` array), sitting alongside -- never replacing -- the existing
// single top-level Inquiry.timeEstimateHoursMin/Max. An inquiry with zero
// rows here behaves exactly as it always has: one implicit session, the
// top-level fields drive every downstream duration lookup. Rows only
// exist when staff explicitly specified more than one session (a single
// declared session still uses the top-level fields, no row created).
//
// depositFormId/appointmentId are both nullable AND unique -- each
// planned session fulfills at most one DepositForm and one Appointment,
// and conversely a given DepositForm/Appointment fulfills at most one
// planned session. Deliberately no cross-referencing constraint beyond
// that: a deposit form for session 3 can be generated (and paid) before
// session 2's even exists, exactly like the un-planned flow already
// allows generating "the next session's" form whenever staff chooses to.
//
// Inquiry.priceEstimateLow/High stays the single source of truth for
// deposit-tier computation -- EVERY planned session's deposit form uses
// the same tier-derived amount, computed once from that whole-project
// price. Once a session plan carries its own per-session price
// (estimatedPriceLow/High below), that whole-project price is no longer
// typed in directly -- it's the sum of every session's own price, the
// same "sessions replace the top-level field" relationship
// estimatedHoursMin/Max already has with the top-level time estimate.
// Both nullable: a plan declared before this feature shipped (or a
// revision that only touched hours) simply has no per-session price yet,
// same "purely additive" posture as the rest of this model.
model PlannedSession {
  id                   String   @id @default(cuid())
  sessionNumber        Int
  estimatedHoursMin    Float
  estimatedHoursMax    Float
  estimatedPriceLow    Float?
  estimatedPriceHigh   Float?
  // Flat-rate pricing: staff can hide this session's hour range from the
  // client-facing estimate/deposit pages -- always still shown to staff
  // (InquiryDetail.tsx) and always still used internally for the
  // scheduling assistant/calendar blocking regardless of this flag; it
  // only controls what a CLIENT sees. Irrelevant for a range-priced
  // session, where the hours ARE the estimate itself -- the estimate-entry
  // UI only ever shows this toggle for a flat-rate row. Defaults true
  // (shown) so every existing row, and every non-flat session going
  // forward, keeps behaving exactly as before this field existed.
  showDurationToClient Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id])

  depositFormId String?      @unique
  depositForm   DepositForm? @relation(fields: [depositFormId], references: [id])

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([inquiryId, sessionNumber])
  @@index([inquiryId])
}

// Prepay + On-Hold epic, Part 1: DEPOSIT is every existing row's implicit
// behavior before this field existed (a tier amount, per depositTiers.ts)
// -- FULL_PREPAY charges the session's full estimated price instead,
// through the exact same signed-form + gift-card-issuance + stackable-
// checkout-redemption pipeline this model and GiftCard already have, just
// a different computed depositAmount and swapped client-facing copy (see
// routes/deposits.ts's own terms-text branch once Part 2 exists). This is
// a genuinely different mechanism from Inquiry.flashPaidAt's own direct-
// Stripe-charge/no-gift-card flow (see FLASH_PAYMENT_PENDING's own schema
// comment) -- despite the surface-level similarity of "pay the full price
// up front," flash payment skips signing AND the gift-card/checkout step
// entirely, neither of which this feature can skip.
enum DepositAmountMode {
  DEPOSIT
  FULL_PREPAY
}

model DepositForm {
  id                          String    @id @default(cuid())
  token                       String    @unique
  tokenExpiresAt              DateTime
  // Which amount this form actually charged for -- see DepositAmountMode's
  // own comment. Default DEPOSIT matches every row that predates this
  // field, all of which really were tier-based deposits.
  amountMode                  DepositAmountMode @default(DEPOSIT)
  agreedNonRefundable         Boolean   @default(false)
  agreedLatePolicy            Boolean   @default(false)
  agreedNoShowForfeit         Boolean   @default(false)
  agreedNewDepositAfterNoShow Boolean   @default(false)
  agreedRescheduleLimit       Boolean   @default(false)
  agreedExpiration            Boolean   @default(false)
  agreedIdAndVoucher          Boolean   @default(false)
  agreedAge18                 Boolean   @default(false)
  signatureName               String?
  // Base64 PNG from signature_pad -- signatureName stays too (the typed
  // legal name backing the drawn mark, shown in the audit trail), it's
  // just no longer the signature itself.
  signatureData               String?
  signedAt                    DateTime?
  // Multi-language public forms: the deposit page's 8 terms (agreedNonRefundable
  // etc. above) are fixed platform copy (a hardcoded TERMS array in
  // routes/deposits.ts, "exact SOP wording" per that file's own comment),
  // not studio-authored -- until now that meant no client-visible text ever
  // varied, so no snapshot was needed (a known, previously-flagged gap --
  // see REPORT.md's "Deposit-form PDF" investigation). The moment a
  // translated (Spanish) version of those same 8 terms exists, the exact
  // wording actually shown at signing must be captured the same way
  // LiabilityWaiver's clausesSnapshot already is, or a later correction to
  // the Spanish translation would silently and retroactively change what
  // an already-signed deposit form appears to say. Array<{ key: string,
  // label: string }>, exactly the 8 TERMS entries as rendered at signing
  // time -- null for every row signed before this field existed. Closes
  // the pre-existing snapshot gap for English signers too, as a byproduct.
  termsSnapshot               Json?
  // Which locale was showing when the client actually signed -- the
  // snapshot above already captures the exact text verbatim regardless of
  // locale; this just records which language it was in, for PDF/audit
  // display. Plain, app-validated String, not an enum -- same reasoning
  // as Client.preferredLocale.
  signedLocale                String?
  depositAmount               Float
  feeAmount                   Float
  totalCharged                Float
  paidManually                Boolean   @default(false)
  paidAt                      DateTime?
  createdAt                   DateTime  @default(now())

  // Package D: purely informational heads-up shown on the public deposit
  // page (e.g. "tentatively scheduled for..."), staff-picked from
  // getSuggestedTimes. Deliberately has NO relation to Appointment and NO
  // gift-card requirement -- this is not a scheduling commitment, real
  // scheduling still only happens via POST /inquiries/:id/schedule after
  // the deposit is paid. Either both set or both null.
  proposedStartAt DateTime?
  proposedEndAt   DateTime?

  // Package M: one project (Inquiry) can now have several deposit forms
  // over time -- one per tattoo session, not just one at conversion. No
  // longer @unique. sessionNumber is purely a labeling convenience (1, 2,
  // 3... in creation order for this inquiry) -- nothing else derives from
  // it, so a gap or out-of-order value from manual data repair would be
  // cosmetic, never a correctness issue.
  inquiryId     String
  inquiry       Inquiry @relation(fields: [inquiryId], references: [id])
  // Default only matters for backfilling existing rows at migration time --
  // every one of them was necessarily the only DepositForm for its inquiry
  // (the unique constraint this replaces guaranteed it), so 1 is exactly
  // correct for all of them, not a guess. The application always sets this
  // explicitly on create; the default is just a safety net, not a relied-on
  // behavior.
  sessionNumber Int     @default(1)

  // One-way optional link to the gift card issued for this deposit, once
  // one exists. Nullable: older/unsigned deposit forms won't have one yet.
  giftCardId String?   @unique
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id])

  // Reverse side of PlannedSession.depositFormId -- set (by Prisma, not
  // read/written directly here) whenever this form was generated for a
  // specific planned session rather than the old un-planned "next session"
  // counter. When set, sessionNumber above is copied from that
  // PlannedSession's own number (no longer purely a creation-order
  // counter in that case) rather than computed as latest+1.
  plannedSession PlannedSession?

  // Phase 7C: set once a real Stripe Checkout Session/PaymentIntent has
  // been created for this deposit (Stripe connected for the studio) --
  // both null for a studio without Stripe connected, or for any deposit
  // paid manually. See DepositForm.paidVia below for which path was
  // actually used.
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  // "STRIPE" once the webhook confirms a real Stripe payment; "MANUAL"
  // once staff use the existing PATCH /:id/mark-paid action -- real shops
  // take cash and comps too, so manual stays available even when Stripe is
  // connected. Null until one of the two actually happens.
  paidVia String?

  @@index([inquiryId, sessionNumber])
}

model GiftCard {
  id          String         @id @default(cuid())
  code        String         @unique
  amountCents Int
  status      GiftCardStatus @default(ACTIVE)
  expiresAt   DateTime?
  paidAt      DateTime?
  redeemedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Stripe checkout-link issuance only -- same fields/naming as
  // DepositForm's own stripeCheckoutSessionId/stripePaymentIntentId, set at
  // checkout-session creation and payment-intent time respectively.
  // Permanently nullable: null for every card issued any other way (Cash,
  // Exempt, or a paid deposit -- that path's own DepositForm carries these
  // fields instead, not the GiftCard it results in).
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  // See the enum's own comment for why this stays nullable permanently.
  // Set on every NEW card going forward, across all three real issuance
  // paths: STRIPE (webhook-confirmed deposit), CASH (staff-recorded
  // in-person collection -- both the deposit mark-paid flow and the
  // general POST /gift-cards issuance route), EXEMPT (the OWNER-only
  // no-payment override, POST /gift-cards/exempt).
  paymentMethod GiftCardPaymentMethod?

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Nullable is deliberate: a card can sit unattached (purchased as an
  // actual gift, or left over after a deposit rollover) until it's used
  // toward a specific appointment. Stackable gift cards: no longer @unique
  // as of the stacking package -- several cards can share one appointmentId,
  // together needing only to meet or exceed the required deposit, not match
  // it exactly. Plain index instead, since lookups by appointmentId
  // (delete-preview, checkout, the attachment-move route) stay common.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // Nullable so a gift card survives (with its full financial value intact)
  // if the staff member who issued it is later deleted from the studio --
  // the card itself is real business/customer money, unlike the account
  // that happened to issue it. Same "preserve content, anonymize actor"
  // precedent already used for Message.authorUserId/AuditLog.actorUserId.
  issuedById String?
  issuedBy   User?   @relation(fields: [issuedById], references: [id])

  depositForm DepositForm?

  // Set only for EXEMPT cards -- an optional staff-facing note (e.g.
  // "Sponsor", "Comped -- prior service issue") explaining why the deposit
  // requirement was waived.
  exemptionReason String?

  // Package O: the reverse side of Client.referralRewardGiftCardId -- lets
  // a referral-reward card be traced back to the specific referral it paid
  // out for. At most one Client ever points here (that FK is @unique).
  referralRewardFor Client? @relation("ReferralRewardGiftCard")

  // Phase 7C: set when THIS card was issued as the leftover from redeeming
  // a larger card at checkout (card value > final cost) -- traces "this
  // smaller card came from redeeming that larger one," for support/audit
  // clarity. Self-relation, one-directional (a card can be derived from at
  // most one original; an original can, in principle, spawn several
  // derived cards over its lifetime -- e.g. redeemed again after being
  // spent down further -- so no @unique on the FK side, and the reverse
  // list is plural). Null for every card issued the normal way (a paid
  // deposit, a manual issuance, a referral reward).
  derivedFromGiftCardId String?
  derivedFromGiftCard   GiftCard?  @relation("GiftCardDerivation", fields: [derivedFromGiftCardId], references: [id])
  derivedGiftCards      GiftCard[] @relation("GiftCardDerivation")

  @@index([studioId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([derivedFromGiftCardId])
}

model LiabilityWaiver {
  id     String                @id @default(cuid())
  status LiabilityWaiverStatus @default(PENDING)

  // Public-flow bearer token -- unlike GiftCard.code, this token IS
  // single-use: it's cleared on signing.
  token          String?   @unique
  tokenExpiresAt DateTime?

  legalName             String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  // Array<{ questionIndex: number, answer: "YES" | "NO", explanation?: string }>
  healthAnswers         Json?
  idImageUrl            String?
  // Array<{ clauseIndex: number, initials: string }>
  clauseInitials        Json?
  signatureName         String?
  // Base64 PNG from signature_pad -- same convention as DepositForm's own
  // signatureName/signatureData pair above (signatureName stays too, the
  // typed legal name backing the drawn mark).
  signatureData         String?

  photoReleaseAccepted      Boolean @default(false)
  photoReleaseSignatureName String?
  photoReleaseSignatureData String?

  // Snapshots of the template exactly as the client saw it at signing time,
  // so a later edit to StudioSettings' waiver template never retroactively
  // changes what a signed record shows (same immutability principle as
  // Inquiry.estimateTermsSnapshot).
  healthQuestionsSnapshot Json
  clausesSnapshot         Json
  acknowledgmentSnapshot  String?
  photoReleaseSnapshot    String?
  // Multi-language public forms: which locale was showing when the client
  // actually signed -- the four snapshots above already capture the exact
  // text verbatim regardless of locale; this just records which language
  // it was in, for PDF/audit display. Plain, app-validated String, not an
  // enum -- same reasoning as Client.preferredLocale.
  signedLocale            String?

  signedAt   DateTime?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  verifiedById String?
  verifiedBy   User?   @relation("WaiverVerifiedBy", fields: [verifiedById], references: [id])

  @@index([studioId])
  @@index([clientId])
}

// Phase 6A: exactly one of clientId/staffUserId is set, matching `type`.
// Prisma can't express "exactly one of two nullable FKs" as a real
// constraint, so this is validated in the route layer (POST /conversations)
// -- noted there too.
model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  // Denormalized for list sorting/preview without joining every message.
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  // Set iff type CLIENT. Unique: one thread per client, ever (see the
  // Client-merge handling in clients.ts for what happens when two clients
  // -- each possibly with their own thread -- become one).
  clientId String? @unique
  client   Client? @relation(fields: [clientId], references: [id])

  // Set iff type STAFF, AND stays set if the thread is later upgraded to
  // GROUP via an @mention (see ConversationParticipant) -- every GROUP
  // conversation started life as a 1:1 STAFF thread, so this becomes "which
  // staff member's original thread this group grew out of," used as a
  // lookup key by /conversations/resolve and the "+ New Chat" roster.
  // Never nulled out on upgrade.
  staffUserId String? @unique
  staffUser   User?   @relation("StaffConversation", fields: [staffUserId], references: [id])

  // Archiving: shared/studio-wide, not per-user -- once archived, hidden
  // from everyone's list (GET /conversations excludes it by default) until
  // someone unarchives it, same "one shared record, not a personal
  // mailbox" model this conversation system already uses everywhere else
  // (visibility is role/permission-driven, never per-user preference).
  // Messages can still be sent to/read from an archived thread (e.g. an
  // inbound client text automatically un-archives it -- see POST /:id/
  // messages) -- archiving hides it from the default list view, it doesn't
  // freeze or lock it.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("ConversationArchivedBy", fields: [archivedById], references: [id])

  messages      Message[]
  reads         ConversationRead[]
  tags          ConversationTag[]
  prefillDrafts PrefillDraft[]
  participants  ConversationParticipant[]
  viewerStates  UserConversationState[]

  @@index([studioId, type, lastMessageAt])
  @@index([studioId, archivedAt])
}

// Links a conversation to a related record elsewhere in the app (that
// record's studio and, for CLIENT threads, its client are validated to
// match at the route layer -- no tagging someone else's inquiry onto a
// thread). entityType is a plain string (like AuditLog.entityType) rather
// than a Prisma enum, so a new taggable entity type never needs a migration.
model ConversationTag {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // Nullable so a tag (cross-referencing a conversation to an Inquiry/
  // Appointment/etc.) survives if whoever created it is later deleted --
  // the cross-reference is real business record, unlike the account that
  // made it.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  @@unique([conversationId, entityType, entityId])
  @@index([studioId])
}

// Immutable communications record for CLIENT threads -- no PATCH/DELETE
// route touches body/channel/direction/attachments there, deliberately: an
// edited copy would no longer match what was actually sent to/received
// from the client over SMS/Email. STAFF/GROUP (internal Team chat)
// messages ARE editable in place (PATCH /:id/messages/:messageId, author
// only) since there's no external channel to drift out of sync with --
// updatedAt distinguishes an edited message from a fresh one, same
// edited-detection idiom as InquiryNote (compare updatedAt to createdAt
// with a small threshold, since the two naturally differ by a few ms even
// on an unedited row).
model Message {
  id          String           @id @default(cuid())
  channel     MessageChannel
  direction   MessageDirection
  body        String
  // Array<string> of Cloudinary URLs, reusing the existing upload flow.
  attachments Json?
  // Set at creation only (messages stay immutable) -- null for ordinary
  // messages. Phase 6B's sanitized share-to-artist sets
  // { kind: "shared_inquiry", inquiryId } so the UI can render a distinct
  // card instead of a plain text bubble.
  metadata    Json?
  createdAt   DateTime         @default(now())
  // @default(now()) alongside @updatedAt (not just @updatedAt alone) so
  // the migration adding this column can backfill every existing row
  // in-place instead of needing an interactive "what default for existing
  // rows" prompt -- Prisma Client still auto-bumps it on every update
  // regardless of the column default.
  updatedAt   DateTime         @default(now()) @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // The staff member who wrote/logged this message. Null is reserved for a
  // future auto-ingested inbound message (e.g. a real IG/SMS webhook) --
  // in this phase every message is logged by a staff member, so it's
  // always set.
  authorUserId String?
  author       User?   @relation("MessageAuthor", fields: [authorUserId], references: [id])

  // iMessage-style quoted reply -- purely a pointer, never rewrites body
  // (unlike edit above, this is additive metadata, so it's allowed on an
  // otherwise-immutable CLIENT thread message too: quoting what a client
  // said isn't altering the record of what they said). SetNull rather than
  // Cascade/Restrict: no route deletes a Message today, but if one ever
  // does, a reply should keep existing with its quote simply gone rather
  // than the delete failing or cascading into every reply.
  replyToId String?
  replyTo   Message?  @relation("MessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplyTo")

  // Tapback-style reactions -- same "additive, not a record edit" reasoning
  // as replyTo above, so also allowed on CLIENT threads. One per (message,
  // user) -- see MessageReaction's own @@unique.
  reactions MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([studioId])
}

// One tapback per (message, user) -- picking a new emoji replaces the
// previous one rather than stacking, same semantics as iMessage's own
// reactions. Fixed to a small quick-set of six enforced at the route layer
// (not the schema, so the set can change without a migration): heart,
// thumbs up, thumbs down, haha, exclamation, question mark.
model MessageReaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@index([messageId])
}

// A server-stored draft of intake-form field values, handed to the public
// intake form via a capability token in the URL -- never the field values
// themselves, so no PII ever rides in a query string. Populated either
// manually by staff (POST /prefill-drafts) or from the Claude-assisted
// draft-inquiry flow. One-time use: usedAt is set on the inquiry submission
// that consumes it, same expire-and-single-use shape as the deposit/waiver
// tokens elsewhere in this app.
model PrefillDraft {
  id        String    @id @default(cuid())
  token     String    @unique
  // Intake-form field values only (contact + tattoo fields) -- shape
  // mirrors a subset of Inquiry's own fields, validated at the route layer.
  payload   Json
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  // Set when generated from a specific conversation (the Claude-assisted
  // flow); null for a plain manual prefill link with no originating thread.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([studioId])
}

// One row per (conversation, user) tracking when that user last read it.
// Missing row means "never read" -- every message counts as unread. Not
// audited: same deliberate noise-exception as SectionSeen (Phase 5) --
// reading a thread happens on every open and carries no business meaning.
model ConversationRead {
  id         String   @id @default(cuid())
  lastReadAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

// Membership for GROUP conversations (a STAFF 1:1 thread upgraded in place
// when someone @mentions a new person into it -- see POST /:id/messages).
// CLIENT and un-upgraded STAFF threads have no rows here; identity for
// those still comes from clientId/staffUserId.
model ConversationParticipant {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

// Phase 5: system tasks are DERIVED live from current data state (see
// apps/api/src/lib/tasks/), never materialized into rows. This is the only
// row that exists per system task, and only once a user dismisses it --
// absence of a row means "not dismissed," not "doesn't exist."
//
// entityId is normally just the underlying record's id, but for task types
// whose "identity" can be refreshed by a real business event (e.g.
// ESTIMATE_FOLLOWUP after a resend), the source encodes that event's
// timestamp into entityId (e.g. "{inquiryId}:{estimateSentAt}") so a fresh
// send produces a fresh, undismissed key rather than staying silently
// dismissed forever. See apps/api/src/lib/tasks/estimateFollowup.ts.
model TaskDismissal {
  id          String   @id @default(cuid())
  taskType    String
  entityId    String
  dismissedAt DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, taskType, entityId])
  @@index([studioId])
}

// Real rows (unlike system tasks) -- a personal to-do belongs to exactly
// one user (the assignee, userId) but may have been created BY someone
// else (UI-1: OWNER/FRONT_DESK assigning a task to a teammate). Assignee-
// only completion; creator or assignee can delete.
model PersonalTask {
  id          String    @id @default(cuid())
  title       String
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  // The assignee -- whoever's "Assigned to Me" list this shows up in.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Who created it. Equal to userId for a self-created task; different
  // when OWNER/FRONT_DESK assigned it to a teammate. Nullable so a live
  // task assigned to someone else survives if its creator is later
  // deleted from the studio -- only the assignee's OWN tasks (userId
  // above, required) are deleted along with them; a task they merely
  // created for a teammate keeps existing with a null creator.
  createdById String?
  createdBy   User?   @relation("PersonalTaskCreatedBy", fields: [createdById], references: [id])

  @@index([studioId])
  @@index([userId])
}

// One row per (user, nav section) tracking when that user last looked.
// Missing row / null lastSeenAt means "never seen" -- count everything.
model SectionSeen {
  id         String   @id @default(cuid())
  section    String
  lastSeenAt DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, section])
}

// Per-user, per-page-type widget layout preference (order + collapsed
// state) for the Inquiry/Project detail pages' reorderable/collapsible
// section cards. pageKey is a plain string ("inquiry-detail",
// "appointment-detail") rather than an enum -- a future third page adopting
// the same layout system needs no migration, just a new key.
model UserWidgetLayout {
  id                 String   @id @default(cuid())
  pageKey            String
  // Array<string> of widget ids, in the user's chosen display order.
  // Widgets whose id isn't present here (new ones added after the user's
  // last save, or ones simply never reordered) render after the listed
  // ones, in their built-in default order -- a saved layout can never
  // hide a widget it doesn't know about.
  widgetOrder        Json
  // Array<string> of currently-collapsed widget ids. An array rather than
  // a Record<string, boolean> since collapsed is the less-common state and
  // stays short; missing from the array means expanded (the default).
  collapsedWidgetIds Json
  updatedAt          DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, pageKey])
}

// Per-user Calendar page preference -- one row per user (unlike
// UserWidgetLayout above, there's only ever one Calendar, no pageKey
// needed). Deliberately does NOT include the currently-viewed date: on a
// fresh visit the calendar should always open on today, the same
// convention every mainstream calendar app uses -- only the VIEW (Month/
// Week/Day) and the filter/display toggles below are meant to survive
// navigating away and back.
model UserCalendarPreference {
  id                 String   @id @default(cuid())
  view               String   @default("month")
  // Array<string> of artist ids, or SQL NULL for "no filter, show every
  // artist" -- the exact same null-means-unfiltered convention
  // Calendar.tsx's own selectedArtistIds state already uses, so this
  // column can be handed straight to/from that state with no translation.
  selectedArtistIds  Json?
  selectedLocationId String?
  includePastGuests  Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

// Phase 7A scheduler foundation. One row per (jobName, scheduledFor) slot --
// deliberately studio-agnostic (a job iterates every studio internally; see
// each job's own comments in apps/api/src/lib/jobs/). The unique constraint
// IS the double-run guard: a job claims its slot with a `create` before
// doing any work, so a second process (or a manual run-now landing on the
// same instant another tick already claimed) hits a unique violation and
// is skipped rather than re-running the work -- see runJob in
// apps/api/src/lib/jobs/registry.ts.
model JobRun {
  id           String    @id @default(cuid())
  jobName      String
  scheduledFor DateTime
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       JobStatus @default(RUNNING)
  // Counts of what the run did (e.g. { cardsExpired: 3 }) -- shape is
  // per-job, not modeled here.
  details      Json?
  error        String?

  @@unique([jobName, scheduledFor])
  @@index([jobName, scheduledFor])
}

// Phase 7B-2: the artist day-before digest is one consolidated message per
// artist per day (not per-appointment), so its dedup can't live on
// Appointment the way the client cadence's does -- it needs its own record
// keyed by (artist, the date being reminded about).
model ArtistReminderLog {
  id      String   @id @default(cuid())
  forDate DateTime
  sentAt  DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id])

  @@unique([artistId, forDate])
}

// Shortens every outbound-SMS-bound public link (estimate/deposit/waiver/
// gift-card/intake/prefill) so a text doesn't arrive as a 70+ character
// raw URL. Deliberately keyed by targetUrl (not by which entity it points
// to) and looked up idempotently in lib/shortLinks.ts -- the same long URL
// always resolves to the same short code, so re-rendering a link that's
// already been shortened once (e.g. a waiver link reused across the
// week-before/night-before/morning-of reminder cadence) never mints a
// second one. No expiry of its own: the destination page's own token
// already carries whatever expiry applies, so an old short link just
// forwards to a page that correctly reports itself expired.
model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  targetUrl String
  createdAt DateTime @default(now())

  @@index([targetUrl])
}

// ---------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------

// v1 deliberately has three types and no more. Each one corresponds to a
// place the WebSocket layer already fires (see lib/realtime/registry.ts),
// so nothing here invents a new "something happened" signal -- it
// persists one that until now existed only for the duration of a socket
// frame, and only for whoever happened to be connected.
enum NotificationType {
  // Someone wrote in a conversation you take part in.
  MESSAGE_CREATED
  // A project was assigned to you.
  INQUIRY_ASSIGNED
  // Someone created a personal task with you as the assignee.
  TASK_ASSIGNED
}

model Notification {
  id   String           @id @default(cuid())
  type NotificationType

  // Rendered as written by both bells. Composed server-side rather than
  // by each client from the payload, so web and mobile cannot phrase the
  // same event differently -- the mistake the "You:" preview bug was.
  title String
  body  String

  // The deep link, as two plain columns rather than something to dig out
  // of `payload`: what kind of thing to open, and which one. Both clients
  // route on exactly this pair.
  entityType String
  entityId   String

  // Anything a specific type needs beyond the link -- e.g. a
  // MESSAGE_CREATED carries its conversationId here even though
  // entityId is already the conversation, so a future per-message deep
  // link does not need a migration. Never required to render the row.
  payload Json?

  // Null until read. Nullable-timestamp rather than a boolean for the
  // same reason every other state in this schema is: WHEN is free.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id])

  // The RECIPIENT. Notifications are per-person, never per-studio: two
  // people at one studio have different feeds and different unread counts.
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id])

  // Who caused it. Null for anything system-generated. Never equal to
  // userId -- every emitter drops the actor from its own recipient list,
  // because being told about a thing you just did is noise.
  actorUserId String?
  actor       User?   @relation("NotificationActor", fields: [actorUserId], references: [id])

  // The feed query (userId, newest first) and the unread count (userId +
  // readAt null) are the only two reads there are, and this index serves
  // both.
  @@index([userId, readAt, createdAt])
  @@index([studioId])
}

// An Expo push token for one device. Registered by apps/mobile at login
// and refreshed on every launch -- Expo rotates these, and a stale one is
// not an error, just a token that will come back DeviceNotRegistered and
// be pruned (see lib/jobs/pushReceiptCheck.ts).
model PushToken {
  id String @id @default(cuid())

  // Unique on the TOKEN, not on (user, token): a physical device handed
  // to a different person must move to that person rather than exist
  // twice, or the previous owner keeps receiving pushes on hardware they
  // no longer hold. POST /push-tokens upserts on this.
  token String @unique

  // "ios" | "android". Free text rather than an enum -- it is diagnostic,
  // never branched on.
  platform   String
  deviceName String?

  createdAt  DateTime @default(now())
  // Bumped on every re-registration, so a device that has stopped calling
  // in is visible as such without waiting for a failed send to prove it.
  lastSeenAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

// One Expo push TICKET awaiting its receipt.
//
// Expo's send call returns a ticket, not a delivery result: the real
// outcome (including DeviceNotRegistered, the only signal that a token is
// dead) arrives minutes later from a separate receipts endpoint. Rows are
// written at send time and deleted once checked, so this table is a queue
// and stays small.
model PushReceipt {
  id       String @id @default(cuid())
  ticketId String @unique

  // The Expo token this ticket was for, as a plain string rather than a
  // relation: the entire purpose of checking is to DELETE that PushToken
  // row when Expo reports the device is gone, and a foreign key would
  // only be in the way of that.
  token String

  createdAt DateTime @default(now())

  // Receipts are not ready immediately -- the checker only picks up rows
  // that have had time to settle, so it queries on this.
  @@index([createdAt])
}

// Per-user, per-conversation preferences: pin and mute.
//
// These had no home before this model. Conversation.archivedAt is
// deliberately STUDIO-WIDE (see its own comment: "one shared record, not a
// personal mailbox"), which is right for archiving and wrong for a pin --
// pinning a thread to the top of YOUR list must not reorder anyone else's.
// So this is the per-user half of conversation state, and the archive stays
// the shared half. The two are not in tension; they answer different
// questions.
//
// lastReadAt is declared and deliberately NOT wired in this work order.
// Unread today is answered by ConversationRead (see
// getUnreadCountForConversation), and consolidating the two is its own
// decision with its own migration of existing rows. Declaring the column
// now means that consolidation is a data move rather than a schema change
// on a hot table -- but nothing reads or writes it yet, and a null here
// means "not yet consolidated", never "never read".
model UserConversationState {
  id String @id @default(cuid())

  userId         String
  conversationId String

  // Denormalized for studio-scoped queries and cleanup. ALWAYS derived
  // server-side from the conversation row -- never read from a request
  // body, same standing rule every other studioId write in this codebase
  // follows.
  studioId String

  isPinned Boolean   @default(false)
  // Set alongside isPinned, and what the per-requester sort orders by --
  // most recently pinned first. Cleared when unpinned, so a re-pin goes
  // back to the top rather than silently keeping its old position.
  pinnedAt DateTime?

  // A future instant, or null. Compared at READ time rather than swept by
  // a job: an expired mute simply stops matching, so there is no window in
  // which a lapsed mute is still suppressing anything and no cleanup job
  // to fall behind.
  mutedUntil DateTime?

  // Reserved -- see this model's own comment. Not read or written yet.
  lastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  // One row per person per thread -- the upsert target.
  @@unique([userId, conversationId])
  @@index([conversationId])
  // Serves the pin-cap count (userId + isPinned) directly.
  @@index([userId, isPinned])
}
